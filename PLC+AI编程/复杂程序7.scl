Network 1 - 初始化程序
|
|--[SM0.1]--|--MOVE--|
|              IN := 0
|              OUT := MW0
|
|--[SM0.1]--|--( R )--M0.0
|           |--( R )--M0.1
|

Network 2 - 初始状态(状态0)判断进入程序1或程序2
|
|--[==I]--|--[I0.7]--|--MOVE--|
|   MW0=0              IN := 1
|                      OUT := MW0
|
|--[==I]--|--[I1.6]--|--MOVE--|
|   MW0=0              IN := 2
|                      OUT := MW0
|

Network 3 - 程序1(状态1)判断
|
|--[==I]--|--[I0.5]--|--MOVE--|
|   MW0=1              IN := 3
|                      OUT := MW0
|

Network 4 - 程序3(状态3)转阀启动
|
|--[==I]--|--( S )--Q0.0
|   MW0=3
|
|--[==I]--|--[I0.6]--|--MOVE--|
|   MW0=3              IN := 4
|                      OUT := MW0
|

Network 5 - 程序2(状态2)判断
|
|--[==I]--|--[I0.0]--|--[I0.1]--|--[I0.6]--|--MOVE--|
|   MW0=2                                     IN := 4
|                                             OUT := MW0
|

Network 6 - 程序4(状态4)主阀启动
|
|--[==I]--|--( S )--Q0.1
|   MW0=4
|
|--[==I]--|--[I0.2]--|--MOVE--|
|   MW0=4              IN := 5
|                      OUT := MW0
|

Network 7 - 程序5(状态5)转阀停止
|
|--[==I]--|--( R )--Q0.0
|   MW0=5
|
|--[==I]--|--MOVE--|
|   MW0=5    IN := 6
|            OUT := MW0
|

Network 8 - 程序6(状态6)同时进入程序7和程序8
|
|--[==I]--|--[NOT M0.0]--|--MOVE--|
|   MW0=6                   IN := 7
|                           OUT := MW1
|
|--[==I]--|--[NOT M0.1]--|--MOVE--|
|   MW0=6                   IN := 8
|                           OUT := MW2
|
|--[==I]--|--[M0.0]--|--[M0.1]--|--MOVE--|
|   MW0=6                          IN := 0
|                                  OUT := MW0
|

Network 9 - 程序7(MW1=7)电机1控制
|
|--[==I]--|-[NOT I1.4]-|--( S )--Q0.2
|   MW1=7              |--[TON T37]
|                         PT=100
|
|--[==I]--|--[T37]--|--( R )--Q0.2
|   MW1=7             |--( S )--M0.0
|                     |--MOVE--|
|                        IN := 0
|                        OUT := MW1
|
|--[==I]--|--[I1.4]--|--( S )--M0.0
|   MW1=7              |--MOVE--|
|                         IN := 0
|                         OUT := MW1
|

Network 10 - 程序8(MW2=8)判断
|
|--[==I]--|--[I0.5]--|--MOVE--|
|   MW2=8              IN := 9
|                      OUT := MW2
|

Network 11 - 程序9(状态9)主阀停止
|
|--[==I]--|--( R )--Q0.1
|   MW2=9
|
|--[==I]--|--[I0.1]--|--MOVE--|
|   MW2=9              IN := 10
|                      OUT := MW2
|                     |--( S )--M0.1
|

Network 12 - 程序10(状态10)判断
|
|--[==I]--|--[NOT I1.4]--|--MOVE--|
|   MW0=10                 IN := 0
|                          OUT := MW0
|                         |--( R )--M0.0
|                         |--( R )--M0.1
|
|--[==I]--|--[I1.4]--|--MOVE--|
|   MW0=10             IN := 11
|                      OUT := MW0
|

Network 13 - 程序11(状态11)扭结电磁阀启动
|
|--[==I]--|--[I1.2]--|--( S )--Q0.3
|   MW0=11            |--MOVE--|
|                        IN := 12
|                        OUT := MW0
|

Network 14 - 程序12(状态12)扭结电磁阀停止
|
|--[==I]--|--[I1.3]--|--( R )--Q0.3
|   MW0=12            |--MOVE--|
|                        IN := 13
|                        OUT := MW0
|

Network 15 - 程序13(状态13)返回初始状态
|
|--[==I]--|--[I1.2]--|--MOVE--|
|   MW0=13             IN := 0
|                      OUT := MW0
|                     |--( R )--M0.0
|                     |--( R )--M0.1
|