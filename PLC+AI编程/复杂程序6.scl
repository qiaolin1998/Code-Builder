S7-200 SMART PLC 梯形图程序

图例说明：
--[ ]--  表示常开触点
--[/]--  表示常闭触点
--( S )-- 表示置位线圈
--( R )-- 表示复位线圈
--[TON]-- 表示定时器
--( )--   表示输出线圈

Network 1 - 初始化程序
|
|--[SM0.1]--|--( S )--M20.0
|

Network 2 - 初始状态：判断进入程序1或程序2
|
|--[M20.0]--|--[I0.7]--|--( S )--M20.1   // 进入程序1
|                       |--( R )--M20.0
|
|--[M20.0]--|--[I1.6]--|--( S )--M20.2   // 进入程序2
|                       |--( R )--M20.0
|

Network 3 - 程序1：进入程序3
|
|--[M20.1]--|--[I0.5]--|--( S )--M20.3   // 进入程序3
|                       |--( R )--M20.1
|

Network 4 - 程序3：转阀启动，进入程序4
|
|--[M20.3]--|--( S )--Q0.0   // 转阀启动
|
|--[M20.3]--|--[I0.6]--|--( S )--M20.4   // 进入程序4
|                       |--( R )--M20.3
|

Network 5 - 程序2：条件同时满足进入程序4
|
|--[M20.2]--|--[I0.0]--|--[I0.1]--|--[I0.6]--|--( S )--M20.4   // 进入程序4
|                                             |--( R )--M20.2
|

Network 6 - 程序4：主阀启动，进入程序5
|
|--[M20.4]--|--( S )--Q0.1   // 主阀启动
|
|--[M20.4]--|--[I0.2]--|--( S )--M20.5   // 进入程序5
|                       |--( R )--M20.4
|

Network 7 - 程序5：转阀停止，进入程序6
|
|--[M20.5]--|--( R )--Q0.0   // 转阀停止
|
|--[M20.5]--|--( S )--M20.6   // 进入程序6
|           |--( R )--M20.5
|

Network 8 - 程序6：同时进入程序7和程序8
|
|--[M20.6]--|--( S )--M20.7   // 进入程序7
|           |--( S )--M21.0   // 进入程序8
|           |--( R )--M20.6
|

Network 9 - 程序7：I1.4断开时电机1启动，计时1秒后停止
|
|--[M20.7]--|--[/I1.4]--|--( S )--Q0.2     // 电机1启动
|                        |--[TON T37]       // 定时器启动
|                                  PT=10    // 1秒 (时基为0.1秒)
|
|--[M20.7]--|--[T37]--|--( R )--Q0.2       // 电机1停止
|                      |--( R )--M20.7      // 断开程序7
|
|--[M20.7]--|--[I1.4]--|--( R )--M20.7     // I1.4导通时，断开程序7
|

Network 10 - 程序8：进入程序9
|
|--[M21.0]--|--[I0.5]--|--( S )--M21.1     // 进入程序9
|                       |--( R )--M21.0
|

Network 11 - 程序9：主阀停止，进入程序10
|
|--[M21.1]--|--( R )--Q0.1     // 主阀停止
|
|--[M21.1]--|--[I0.1]--|--( S )--M21.2     // 进入程序10
|                       |--( R )--M21.1
|

Network 12 - 程序10：根据I1.4状态进入初始状态或程序11
|
|--[M21.2]--|--[/I1.4]--|--( S )--M20.0    // I1.4断开，进入初始状态
|                        |--( R )--M21.2
|
|--[M21.2]--|--[I1.4]--|--( S )--M21.3     // I1.4导通，进入程序11
|                       |--( R )--M21.2
|

Network 13 - 程序11：扭结电磁阀启动，进入程序12
|
|--[M21.3]--|--[I1.2]--|--( S )--Q0.3      // 扭结电磁阀启动
|                       |--( S )--M21.4     // 进入程序12
|                       |--( R )--M21.3
|

Network 14 - 程序12：扭结电磁阀停止，进入程序13
|
|--[M21.4]--|--[I1.3]--|--( R )--Q0.3      // 扭结电磁阀停止
|                       |--( S )--M21.5     // 进入程序13
|                       |--( R )--M21.4
|

Network 15 - 程序13：进入初始状态
|
|--[M21.5]--|--[I1.2]--|--( S )--M20.0     // 进入初始状态
|                       |--( R )--M21.5
| 