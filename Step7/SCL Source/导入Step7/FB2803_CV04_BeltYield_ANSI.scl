FUNCTION_BLOCK FB2803 

TITLE = 'CV04BeltYieldCalculation' 
// 
// 功能块名称：FB2803 CV04皮带瞬时/累计矿量计算功能块
// 版本：V1.0
// 作者：QIAO
// 创建日期：2026-09-13
// 
// 功能概述：
//   CV06、CV07两条皮带均可以向CV04皮带下料，每条皮带各有一个现场点位
//   （如犁料器/分料器到位信号），用于判断该皮带当前是否正在向CV04下料。
//   本功能块根据该点位对CV06、CV07的瞬时矿量进行门控求和，得到CV04皮带
//   的瞬时矿量，并按扫描周期对瞬时矿量进行积分，计算CV04皮带的累计矿量。
// 
// 工艺关系：
//   CV04瞬时矿量(t/h)
//     = (CV06_ToCV04有效 ? CV06瞬时矿量 : 0)
//     + (CV07_ToCV04有效 ? CV07瞬时矿量 : 0)
//   本扫描周期增量(t) = CV04瞬时矿量(t/h) × 扫描间隔(s) / 3600
// 
// 浮点数溢出（精度丢失）防护原理：
//   S7-300/400的REAL只有约7位有效数字，若把每个扫描周期的微小增量
//   直接累加到一个不断增大的REAL总量上，当总量增大到一定程度后，
//   小增量会被大数“吃掉”（例如总量到百万吨级后，每周期几公斤的
//   增量将无法被累加），表现为累计量停滞、不增长。
//   本功能块采用三级累加结构：
//     第一级 Accum_Small：微小增量累加器，数值始终小于约1吨；
//     第二级 Total_Low  ：低段累计量(REAL)，数值始终在0~100吨之间；
//     第三级 Total_High ：高段累计量(DINT)，单位为100吨。
//   由于没有任何REAL变量会超过百吨量级，REAL始终有足够的有效数字；
//   DINT高段最大可表示 2147483647×100 ≈ 2.1×10^11 吨，
//   按皮带常年连续运行计算也不可能达到，因此不会溢出。
// 
// 适用场景：
//   - 多条皮带通过分料装置向同一条汇集皮带(CV04)下料的产量计量
//   - 现场只能提供各给料皮带瞬时流量(t/h)及下料到位点位的场合
// 
VERSION: '1.0' 
AUTHOR: QIAO 
NAME:BeltYld
FAMILY:QFam


// ============================================================
// 输入参数（VAR_INPUT）
// ============================================================
VAR_INPUT 
    // CV06皮带瞬时矿量（单位：吨/小时 t/h，整数）
    // 说明：来自CV06皮带秤的瞬时流量信号，INT整数类型。
    CV06_Instant:INT; 

    // CV07皮带瞬时矿量（单位：吨/小时 t/h，整数）
    // 说明：来自CV07皮带秤的瞬时流量信号，INT整数类型。
    CV07_Instant:INT; 

    // CV06向CV04下料点位
    // 说明：现场犁料器/分料器/挡板到位信号。
    //       TRUE 表示CV06当前正在向CV04皮带下料，其瞬时矿量计入CV04；
    //       FALSE表示CV06未向CV04下料，其瞬时矿量不计入CV04。
    CV06_ToCV04:BOOL;

    // CV07向CV04下料点位（含义同上）
    //       TRUE 表示CV07当前正在向CV04皮带下料；
    //       FALSE表示CV07未向CV04下料。
    CV07_ToCV04:BOOL;

    // 初始化信号（电平有效）
    // 说明：信号为TRUE时，CV04累计矿量清零并重新开始累计。
    //       用于HMI清零按钮或系统重新投运。
    Initialize:BOOL;

    // 允许的最大扫描间隔（单位：秒，默认10.0秒）
    // 说明：TIME_TCK时钟在CPU重新上电后会从0重新开始计时，
    //       此时本周期计算出的时间间隔会异常大；PLC长时间停机后
    //       恢复运行时同理。为避免把停机期间的虚假时间计入矿量，
    //       当扫描间隔大于该设定值时，本扫描周期不进行积分，
    //       仅刷新时间基准。正常OB1扫描周期远小于该值，不影响计量。
    //       注意：该值必须设置为大于0的数。
    Max_CycleTime:REAL:=10.0;
END_VAR 


// ============================================================
// 输出参数（VAR_OUTPUT）
// ============================================================
VAR_OUTPUT 
    // CV04皮带瞬时矿量（单位：吨/小时 t/h，整数）
    // 说明：CV06、CV07中实际向CV04下料的各皮带瞬时矿量之和。
    //       注意：INT范围为0~32767 t/h，需确认两条皮带同时下料时
    //       的瞬时量之和不超过32767，否则应改用DINT。
    CV04_Instant:INT:=0;

    // CV04皮带累计矿量（单位：吨）
    // 说明：由高段和低段合成的总累计量，供HMI显示使用。
    //       = CV04_Total_High × 100 + CV04_Total_Low
    //       当总量超过REAL精确显示范围后，建议HMI直接使用
    //       CV04_Total_High与CV04_Total_Low拼接显示，内部累计
    //       精度不受任何影响。
    CV04_Total:REAL:=0.0;

    // CV04累计矿量高段（单位：100吨，DINT整数）
    // 说明：每累计满100吨，该值加1。
    CV04_Total_High:DINT:=0;

    // CV04累计矿量低段（单位：吨，范围0.0 ~ 100.0）
    // 说明：未满100吨的余数部分，与高段配合组成完整累计量。
    CV04_Total_Low:REAL:=0.0;

    // 初始化完成标志
    // TRUE表示功能块已完成初始化，可以正常工作
    Init_Done:BOOL:=FALSE;
END_VAR 

// ============================================================
// 临时变量（VAR_TEMP）
// ============================================================
// 说明：临时变量在每次扫描周期结束后会被清除，不能保存数据。
VAR_TEMP 
    CurrentTick:TIME;                  // 本次扫描读取的CPU运行时间（毫秒）
                                      // 由TIME_TCK读取，数据类型为TIME
                                      // （TIME与DINT均为32位，毫秒单位）

    DeltaMs:DINT;                     // 本次与上次扫描的时间间隔（毫秒）
                                      // 由两个TIME值相减后转换得到

    DeltaSec:REAL;                    // 本次与上次扫描的时间间隔（秒）

    Increment:REAL;                   // 本扫描周期的矿量增量（吨）

    Inst06:INT;                       // 经下料点位门控后的CV06瞬时矿量
    Inst07:INT;                       // 经下料点位门控后的CV07瞬时矿量

    BandCount:DINT;                   // 低段向高段进位的个数（每100吨进1）
END_VAR 

// ============================================================
// 静态变量（VAR）
// ============================================================
// 说明：静态变量在功能块调用期间会保持其值，用于跨扫描周期保存数据。
VAR 
    LastTick:TIME;                    // 上一次扫描时的CPU运行时间（毫秒）
                                      // 用于计算扫描间隔，TIME类型

    IsFirstScan:BOOL:=TRUE;           // 首次扫描标志
                                      // TRUE表示功能块第一次运行，需要初始化

    Accum_Small:REAL:=0.0;            // 第一级：微小增量累加器（吨）
                                      // 每周期的矿量增量先累加到此处，
                                      // 数值始终小于约1吨(Small_Limit)

    Total_Low:REAL:=0.0;              // 第二级：低段累计量（吨，0~100）

    Total_High:DINT:=0;               // 第三级：高段累计量（单位100吨）

    // ============================================================
    // 累加结构常数（运行中不修改）
    // ============================================================
    Small_Limit:REAL:=1.0;            // 小累加器进位阈值（吨）
                                      // 小累加器每满1吨，向低段累计量进1吨

    Band_Size:REAL:=100.0;            // 低段容量（吨）
                                      // 低段每满100吨，向高段进1
END_VAR 

// ============================================================
// 程序主逻辑开始
// ============================================================

// ------------------------------------------------------------
// 第一步：读取CPU运行时间
// ------------------------------------------------------------
// TIME_TCK返回CPU启动以来的运行时间（TIME类型，毫秒），约24.8天回绕一次
// （由+2147483647跳变为-2147483648），后面利用TIME类型的32位减法
// 可以自动处理该回绕，无需额外判断。
CurrentTick:=TIME_TCK();

// ------------------------------------------------------------
// 第二步：首次扫描初始化（只执行一次）
// ------------------------------------------------------------
IF IsFirstScan THEN
    // 累计量三级累加器全部清零
    Accum_Small:=0.0;
    Total_Low:=0.0;
    Total_High:=0;

    // 累计量输出清零
    CV04_Total:=0.0;
    CV04_Total_High:=0;
    CV04_Total_Low:=0.0;

    // 记录时间基准，首次扫描不进行积分（时间间隔未知）
    LastTick:=CurrentTick;

    // 标记首次扫描完成
    IsFirstScan:=FALSE;
    Init_Done:=TRUE;
END_IF;

// ------------------------------------------------------------
// 第三步：手动初始化清零（由HMI或程序触发）
// ------------------------------------------------------------
IF Initialize THEN
    // 累计量三级累加器全部清零
    Accum_Small:=0.0;
    Total_Low:=0.0;
    Total_High:=0;

    // 累计量输出清零
    CV04_Total:=0.0;
    CV04_Total_High:=0;
    CV04_Total_Low:=0.0;

    // 同时刷新时间基准，避免把清零前的时间计入新累计量
    LastTick:=CurrentTick;

    Init_Done:=TRUE;
END_IF;

// ------------------------------------------------------------
// 第四步：计算CV04皮带瞬时矿量
// ------------------------------------------------------------
// 各皮带瞬时矿量必须同时满足"下料点位有效"且"瞬时量为正"才计入，
// 剔除皮带秤停机时可能出现的负值/零漂。
IF CV06_ToCV04 AND CV06_Instant > 0 THEN
    Inst06:=CV06_Instant;
ELSE
    Inst06:=0;
END_IF;

IF CV07_ToCV04 AND CV07_Instant > 0 THEN
    Inst07:=CV07_Instant;
ELSE
    Inst07:=0;
END_IF;

// CV04瞬时矿量 = 实际向CV04下料的各皮带瞬时矿量之和
// 两条皮带可同时向CV04下料，此时为两者瞬时矿量相加
CV04_Instant:=Inst06 + Inst07;

// ------------------------------------------------------------
// 第五步：计算扫描间隔（毫秒）
// ------------------------------------------------------------
// S7-SCL不允许DWORD直接做减法，因此这里利用TIME类型可以直接
// 相减的特性（底层同为32位毫秒值）：
//   正常情况：当前值 > 上次值，差值为正；
//   回绕情况：TIME_TCK约24.8天回绕一次，32位减法天然按2^32取模，
//            回绕后仍能得到正确的正向小间隔；
//   CPU重启：当前值从0开始，差值为负，
//            由下一步的DeltaMs>0及Max_CycleTime合理性判断剔除。
// TIME_TO_DINT仅按位转换，不改变数值和单位（毫秒）。
DeltaMs:=TIME_TO_DINT(CurrentTick - LastTick);

// ------------------------------------------------------------
// 第六步：时间间隔合理性判断与累计矿量积分
// ------------------------------------------------------------
// 只有时间间隔为正、且不超过允许的最大扫描间隔时才积分，
// 防止CPU停机、时钟回绕异常等情况下产生虚假矿量。
IF DeltaMs > 0 AND DINT_TO_REAL(DeltaMs)/1000.0 <= Max_CycleTime THEN

    // 毫秒换算为秒
    DeltaSec:=DINT_TO_REAL(DeltaMs)/1000.0;

    // 本扫描周期增量(吨) = 瞬时量(t/h) × 时间(s) / 3600
    // 瞬时量为INT整数，积分前先转换为REAL
    Increment:=INT_TO_REAL(CV04_Instant) * DeltaSec / 3600.0;

    // ---- 第一级：微小增量累加 ----
    // 增量始终累加到一个数值很小的REAL变量上，
    // 保证即使每周期增量只有几公斤也不会丢失精度。
    Accum_Small:=Accum_Small + Increment;

    // ---- 第一级 → 第二级：小累加器满1吨向低段进位 ----
    // 采用按固定1吨逐次进位，余数继续保留在小累加器中。
    // 循环次数极少（正常扫描周期下一般不超过数次）。
    WHILE Accum_Small >= Small_Limit DO
        Total_Low:=Total_Low + Small_Limit;
        Accum_Small:=Accum_Small - Small_Limit;
    END_WHILE;

    // ---- 第二级 → 第三级：低段满100吨向高段(DINT)进位 ----
    // 用除法一次性计算进位个数，兼容时间间隔较大时
    // 单周期增量可能跨越多个100吨段的极端情况。
    IF Total_Low >= Band_Size THEN
        BandCount:=REAL_TO_DINT(Total_Low / Band_Size);
        Total_High:=Total_High + BandCount;
        Total_Low:=Total_Low - DINT_TO_REAL(BandCount) * Band_Size;
    END_IF;
END_IF;

// ------------------------------------------------------------
// 第七步：合成并输出累计矿量
// ------------------------------------------------------------
// 低段始终保持在0~100吨之间，高段为100吨的整数倍(DINT)，
// 任何REAL变量都不会无限增大，从根本上避免浮点累加溢出。
CV04_Total_Low:=Total_Low;
CV04_Total_High:=Total_High;
CV04_Total:=DINT_TO_REAL(Total_High) * Band_Size + Total_Low;

// ------------------------------------------------------------
// 第八步：保存本次时间基准（供下一次扫描使用）
// ------------------------------------------------------------
LastTick:=CurrentTick;

END_FUNCTION_BLOCK

// ============================================================
// 数据块定义
// ============================================================
// 说明：FB2803需要一个对应的背景数据块来存储运行时数据
//       在Step7中创建数据块DB2803，类型选择FB2803即可
DATA_BLOCK DB2803 FB2803
BEGIN
END_DATA_BLOCK
