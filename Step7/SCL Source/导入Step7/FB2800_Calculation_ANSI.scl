 VERSION: '1.3' 
 AUTHOR: QIAO 
 NAME:ProCount
 FAMILY:QFam
 
 
 
 //���� 
 VAR_INPUT 
 //ʵʱʵʱƤ�������ۼ��� 
 Product_Total:REAL; 
 //��ʼ���źţ���������Ч��
