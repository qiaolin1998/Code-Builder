FUNCTION_BLOCK FB2804

TITLE = 'S120_AlarmFaultRecorder'
//
// 功能块名称：FB2804 S120变频器报警故障记录功能块
// 版本：V1.0
// 作者：QIAO
// 创建日期：2026-10-01
//
// 功能概述：
//   本功能块用于在设备每次停机时，自动记录S120变频器的报警代码(AlarmCode)
//   与故障代码(FaultCode)，并将代码值映射到DB2804中对应的bool标志位，
//   便于HMI直接显示具体的报警/故障名称说明。
//
// 核心原理：
//   1. 检测设备运行信号(Drive_Run)的下降沿，判定为一次停机事件；
//   2. 停机瞬间读取S120的报警代码与故障代码并锁定保存；
//   3. 通过CASE语句将代码值映射到DB2804中对应的bool变量置位；
//   4. 同时将停机时间与代码写入最近16次历史记录数组，便于追溯。
//
// 与S120通信数据关联（参考CV05_DB2）：
//   Drive_AlarmCode  ← "CV05MainMotor".Driver1_AlarmCode (INT)
//   Drive_FaultCode  ← "CV05MainMotor".Driver1_FaultCode (INT)
//
// 适用场景：
//   - S120变频器驱动的皮带/电机设备，需要记录每次停机的报警/故障原因
//   - 需要在HMI上以bool点位方式直接显示具体报警/故障名称的场合
//
VERSION: '1.0'
AUTHOR: QIAO
NAME:S120Rec
FAMILY:QFam


// ============================================================
// 输入参数（VAR_INPUT）
// ============================================================
VAR_INPUT
    // 设备运行信号
    // 说明：来自S120状态字"运行使能"或接触器反馈，TRUE表示设备正在运行。
    //       下降沿(FALSE→TRUE的反向)触发一次停机记录。
    Drive_Run:BOOL;

    // S120报警代码（A-code，INT整数）
    // 说明：来自S120通讯读取的AlarmCode，如A0500对应代码500。
    //       取值范围0~9999，0表示无报警。
    Drive_AlarmCode:INT;

    // S120故障代码（F-code，INT整数）
    // 说明：来自S120通讯读取的FaultCode，如F0001对应代码1。
    //       取值范围0~9999，0表示无故障。
    Drive_FaultCode:INT;

    // 初始化信号（电平有效）
    // 说明：TRUE时清零所有历史记录与bool标志位，重新开始记录。
    Initialize:BOOL;

    // ============================================================
    // 系统时间输入（用于记录停机时刻）
    // 说明：建议由OB1中读取系统时钟(READ_CLK)后传入，BCD转INT。
    // ============================================================
    Year:INT;
    Month:INT;
    Day:INT;
    Hour:INT;
    Minute:INT;
    Second:INT;
END_VAR


// ============================================================
// 输出参数（VAR_OUTPUT）
// ============================================================
VAR_OUTPUT
    // 上次停机时的报警代码
    // 说明：最近一次停机瞬间锁定的Drive_AlarmCode值。
    Last_Stop_AlarmCode:INT:=0;

    // 上次停机时的故障代码
    // 说明：最近一次停机瞬间锁定的Drive_FaultCode值。
    Last_Stop_FaultCode:INT:=0;

    // 累计停机次数
    // 说明：自上次初始化以来的设备停机总次数。
    Stop_Count:DINT:=0;

    // 初始化完成标志
    Init_Done:BOOL:=FALSE;
END_VAR

// ============================================================
// 临时变量（VAR_TEMP）
// ============================================================
// 说明：临时变量在每次扫描周期结束后清除，用于循环计数等。
VAR_TEMP
    i:INT;                          // 循环索引
END_VAR

// ============================================================
// 静态变量（VAR）
// ============================================================
// 说明：静态变量跨扫描周期保持，用于保存历史记录与边沿检测。
VAR
    Drive_Run_Last:BOOL;            // 上一扫描周期的运行信号
                                    // 用于下降沿检测

    IsFirstScan:BOOL:=TRUE;         // 首次扫描标志

    // ============================================================
    // 最近16次停机历史记录
    // 说明：数组下标1为最近一次停机，下标16为最旧一次。
    //       新停机发生时整体后移（右移），新记录写入下标1。
    // ============================================================
    Hist_Alarm:ARRAY[1..16] OF INT;     // 历史报警代码
    Hist_Fault:ARRAY[1..16] OF INT;     // 历史故障代码
    Hist_Year:ARRAY[1..16] OF INT;      // 停机年份
    Hist_Month:ARRAY[1..16] OF INT;     // 停机月份
    Hist_Day:ARRAY[1..16] OF INT;       // 停机日期
    Hist_Hour:ARRAY[1..16] OF INT;      // 停机小时
    Hist_Minute:ARRAY[1..16] OF INT;    // 停机分钟
END_VAR

// ============================================================
// 程序主逻辑开始
// ============================================================

// ------------------------------------------------------------
// 第一步：首次扫描初始化
// ------------------------------------------------------------
IF IsFirstScan THEN
    Drive_Run_Last:=Drive_Run;
    Stop_Count:=0;
    Last_Stop_AlarmCode:=0;
    Last_Stop_FaultCode:=0;

    // 清零历史记录数组
    FOR i:=1 TO 16 DO
        Hist_Alarm[i]:=0;
        Hist_Fault[i]:=0;
        Hist_Year[i]:=0;
        Hist_Month[i]:=0;
        Hist_Day[i]:=0;
        Hist_Hour[i]:=0;
        Hist_Minute[i]:=0;
    END_FOR;

    IsFirstScan:=FALSE;
    Init_Done:=TRUE;
END_IF;

// ------------------------------------------------------------
// 第二步：手动初始化清零
// ------------------------------------------------------------
IF Initialize THEN
    Stop_Count:=0;
    Last_Stop_AlarmCode:=0;
    Last_Stop_FaultCode:=0;

    FOR i:=1 TO 16 DO
        Hist_Alarm[i]:=0;
        Hist_Fault[i]:=0;
        Hist_Year[i]:=0;
        Hist_Month[i]:=0;
        Hist_Day[i]:=0;
        Hist_Hour[i]:=0;
        Hist_Minute[i]:=0;
    END_FOR;

    // 清零DB2804中所有报警/故障bool标志位
    DB2804_S120_Codes.Alarm_0500:=FALSE;
    DB2804_S120_Codes.Alarm_0501:=FALSE;
    DB2804_S120_Codes.Alarm_0502:=FALSE;
    DB2804_S120_Codes.Alarm_0503:=FALSE;
    DB2804_S120_Codes.Alarm_0504:=FALSE;
    DB2804_S120_Codes.Alarm_0505:=FALSE;
    DB2804_S120_Codes.Alarm_0506:=FALSE;
    DB2804_S120_Codes.Alarm_0507:=FALSE;
    DB2804_S120_Codes.Alarm_0508:=FALSE;
    DB2804_S120_Codes.Alarm_0509:=FALSE;
    DB2804_S120_Codes.Alarm_0510:=FALSE;
    DB2804_S120_Codes.Alarm_0511:=FALSE;
    DB2804_S120_Codes.Alarm_0512:=FALSE;
    DB2804_S120_Codes.Alarm_0513:=FALSE;
    DB2804_S120_Codes.Alarm_0514:=FALSE;
    DB2804_S120_Codes.Alarm_0515:=FALSE;

    DB2804_S120_Codes.Fault_0001:=FALSE;
    DB2804_S120_Codes.Fault_0002:=FALSE;
    DB2804_S120_Codes.Fault_0003:=FALSE;
    DB2804_S120_Codes.Fault_0004:=FALSE;
    DB2804_S120_Codes.Fault_0005:=FALSE;
    DB2804_S120_Codes.Fault_0006:=FALSE;
    DB2804_S120_Codes.Fault_0009:=FALSE;
    DB2804_S120_Codes.Fault_0011:=FALSE;
    DB2804_S120_Codes.Fault_0012:=FALSE;
    DB2804_S120_Codes.Fault_0015:=FALSE;
    DB2804_S120_Codes.Fault_0021:=FALSE;
    DB2804_S120_Codes.Fault_0030:=FALSE;
    DB2804_S120_Codes.Fault_0035:=FALSE;
    DB2804_S120_Codes.Fault_0036:=FALSE;
    DB2804_S120_Codes.Fault_0041:=FALSE;
    DB2804_S120_Codes.Fault_0042:=FALSE;
    DB2804_S120_Codes.Fault_0044:=FALSE;
    DB2804_S120_Codes.Fault_0052:=FALSE;
    DB2804_S120_Codes.Fault_0054:=FALSE;
    DB2804_S120_Codes.Fault_0060:=FALSE;
    DB2804_S120_Codes.Fault_0061:=FALSE;
    DB2804_S120_Codes.Fault_0062:=FALSE;
    DB2804_S120_Codes.Fault_0063:=FALSE;
    DB2804_S120_Codes.Fault_0064:=FALSE;
    DB2804_S120_Codes.Fault_0065:=FALSE;
    DB2804_S120_Codes.Fault_0066:=FALSE;
    DB2804_S120_Codes.Fault_0070:=FALSE;
    DB2804_S120_Codes.Fault_0071:=FALSE;
    DB2804_S120_Codes.Fault_0072:=FALSE;
    DB2804_S120_Codes.Fault_0073:=FALSE;
    DB2804_S120_Codes.Fault_0074:=FALSE;
    DB2804_S120_Codes.Fault_0075:=FALSE;
    DB2804_S120_Codes.Fault_0076:=FALSE;
    DB2804_S120_Codes.Fault_0077:=FALSE;
    DB2804_S120_Codes.Fault_0078:=FALSE;
    DB2804_S120_Codes.Fault_0079:=FALSE;
    DB2804_S120_Codes.Fault_0080:=FALSE;
    DB2804_S120_Codes.Fault_0085:=FALSE;
    DB2804_S120_Codes.Fault_0090:=FALSE;
    DB2804_S120_Codes.Fault_0100:=FALSE;

    Init_Done:=TRUE;
END_IF;

// ------------------------------------------------------------
// 第三步：检测停机下降沿并记录报警/故障代码
// ------------------------------------------------------------
// 下降沿判定：上一周期为TRUE，本周期为FALSE，即设备从运行变为停止
IF Drive_Run_Last AND NOT Drive_Run THEN

    // 停机次数加1
    Stop_Count:=Stop_Count + 1;

    // 锁定本次停机的报警与故障代码
    Last_Stop_AlarmCode:=Drive_AlarmCode;
    Last_Stop_FaultCode:=Drive_FaultCode;

    // ============================================================
    // 报警代码映射：将INT代码置位DB2804中对应的bool标志
    // ============================================================
    // 说明：S120报警代码为Axxxx格式，此处取数值部分。
    //       例如A0500 → 代码500 → Alarm_0500 := TRUE
    CASE Drive_AlarmCode OF
        500: DB2804_S120_Codes.Alarm_0500:=TRUE;
        501: DB2804_S120_Codes.Alarm_0501:=TRUE;
        502: DB2804_S120_Codes.Alarm_0502:=TRUE;
        503: DB2804_S120_Codes.Alarm_0503:=TRUE;
        504: DB2804_S120_Codes.Alarm_0504:=TRUE;
        505: DB2804_S120_Codes.Alarm_0505:=TRUE;
        506: DB2804_S120_Codes.Alarm_0506:=TRUE;
        507: DB2804_S120_Codes.Alarm_0507:=TRUE;
        508: DB2804_S120_Codes.Alarm_0508:=TRUE;
        509: DB2804_S120_Codes.Alarm_0509:=TRUE;
        510: DB2804_S120_Codes.Alarm_0510:=TRUE;
        511: DB2804_S120_Codes.Alarm_0511:=TRUE;
        512: DB2804_S120_Codes.Alarm_0512:=TRUE;
        513: DB2804_S120_Codes.Alarm_0513:=TRUE;
        514: DB2804_S120_Codes.Alarm_0514:=TRUE;
        515: DB2804_S120_Codes.Alarm_0515:=TRUE;
    END_CASE;

    // ============================================================
    // 故障代码映射：将INT代码置位DB2804中对应的bool标志
    // ============================================================
    // 说明：S120故障代码为Fxxxx格式，此处取数值部分。
    //       例如F0001 → 代码1 → Fault_0001 := TRUE
    CASE Drive_FaultCode OF
        1:   DB2804_S120_Codes.Fault_0001:=TRUE;
        2:   DB2804_S120_Codes.Fault_0002:=TRUE;
        3:   DB2804_S120_Codes.Fault_0003:=TRUE;
        4:   DB2804_S120_Codes.Fault_0004:=TRUE;
        5:   DB2804_S120_Codes.Fault_0005:=TRUE;
        6:   DB2804_S120_Codes.Fault_0006:=TRUE;
        9:   DB2804_S120_Codes.Fault_0009:=TRUE;
        11:  DB2804_S120_Codes.Fault_0011:=TRUE;
        12:  DB2804_S120_Codes.Fault_0012:=TRUE;
        15:  DB2804_S120_Codes.Fault_0015:=TRUE;
        21:  DB2804_S120_Codes.Fault_0021:=TRUE;
        30:  DB2804_S120_Codes.Fault_0030:=TRUE;
        35:  DB2804_S120_Codes.Fault_0035:=TRUE;
        36:  DB2804_S120_Codes.Fault_0036:=TRUE;
        41:  DB2804_S120_Codes.Fault_0041:=TRUE;
        42:  DB2804_S120_Codes.Fault_0042:=TRUE;
        44:  DB2804_S120_Codes.Fault_0044:=TRUE;
        52:  DB2804_S120_Codes.Fault_0052:=TRUE;
        54:  DB2804_S120_Codes.Fault_0054:=TRUE;
        60:  DB2804_S120_Codes.Fault_0060:=TRUE;
        61:  DB2804_S120_Codes.Fault_0061:=TRUE;
        62:  DB2804_S120_Codes.Fault_0062:=TRUE;
        63:  DB2804_S120_Codes.Fault_0063:=TRUE;
        64:  DB2804_S120_Codes.Fault_0064:=TRUE;
        65:  DB2804_S120_Codes.Fault_0065:=TRUE;
        66:  DB2804_S120_Codes.Fault_0066:=TRUE;
        70:  DB2804_S120_Codes.Fault_0070:=TRUE;
        71:  DB2804_S120_Codes.Fault_0071:=TRUE;
        72:  DB2804_S120_Codes.Fault_0072:=TRUE;
        73:  DB2804_S120_Codes.Fault_0073:=TRUE;
        74:  DB2804_S120_Codes.Fault_0074:=TRUE;
        75:  DB2804_S120_Codes.Fault_0075:=TRUE;
        76:  DB2804_S120_Codes.Fault_0076:=TRUE;
        77:  DB2804_S120_Codes.Fault_0077:=TRUE;
        78:  DB2804_S120_Codes.Fault_0078:=TRUE;
        79:  DB2804_S120_Codes.Fault_0079:=TRUE;
        80:  DB2804_S120_Codes.Fault_0080:=TRUE;
        85:  DB2804_S120_Codes.Fault_0085:=TRUE;
        90:  DB2804_S120_Codes.Fault_0090:=TRUE;
        100: DB2804_S120_Codes.Fault_0100:=TRUE;
    END_CASE;

    // ============================================================
    // 历史记录数组右移（最旧记录丢弃，最新记录写入下标1）
    // ============================================================
    FOR i:=16 DOWNTO 2 DO
        Hist_Alarm[i]:=Hist_Alarm[i-1];
        Hist_Fault[i]:=Hist_Fault[i-1];
        Hist_Year[i]:=Hist_Year[i-1];
        Hist_Month[i]:=Hist_Month[i-1];
        Hist_Day[i]:=Hist_Day[i-1];
        Hist_Hour[i]:=Hist_Hour[i-1];
        Hist_Minute[i]:=Hist_Minute[i-1];
    END_FOR;

    // 写入本次停机记录到下标1（最近一次）
    Hist_Alarm[1]:=Drive_AlarmCode;
    Hist_Fault[1]:=Drive_FaultCode;
    Hist_Year[1]:=Year;
    Hist_Month[1]:=Month;
    Hist_Day[1]:=Day;
    Hist_Hour[1]:=Hour;
    Hist_Minute[1]:=Minute;
END_IF;

// ------------------------------------------------------------
// 第四步：保存本周期运行信号（供下一周期边沿检测使用）
// ------------------------------------------------------------
Drive_Run_Last:=Drive_Run;

END_FUNCTION_BLOCK



// ============================================================
// 背景数据块
// ============================================================
// 说明：FB2804的背景数据块，存储运行时静态变量
DATA_BLOCK DB2804 FB2804
BEGIN
END_DATA_BLOCK
