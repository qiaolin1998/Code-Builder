

// ============================================================
// S120报警/故障代码映射数据块
// ============================================================
// 说明：本数据块为全局共享数据块，定义了S120常见报警/故障代码
//       对应的bool标志位及中文名称说明。
//       当FB2804检测到设备停机时，根据读取到的代码值将对应的
//       bool变量置位，HMI可直接读取bool变量并显示名称。
//       每个bool变量旁的注释即为该代码的中文名称说明。
//
// 代码格式说明：
//   报警代码(Alarm) ：S120中以"A"开头，如A0500，此处变量名Alarm_0500
//   故障代码(Fault) ：S120中以"F"开头，如F0001，此处变量名Fault_0001
//
DATA_BLOCK DB2804_S120_Codes

STRUCT
    // ============================================================
    // 报警代码组 (A-codes)
    // ============================================================
    Alarm_0500:BOOL;   // 编码器1信号丢失 (Encoder 1 signal lost)
    Alarm_0501:BOOL;   // 编码器2信号丢失 (Encoder 2 signal lost)
    Alarm_0502:BOOL;   // 编码器1信号幅值过低
    Alarm_0503:BOOL;   // 编码器2信号幅值过低
    Alarm_0504:BOOL;   // 编码器1信号频率超限
    Alarm_0505:BOOL;   // 编码器2信号频率超限
    Alarm_0506:BOOL;   // 编码器1零脉冲缺失
    Alarm_0507:BOOL;   // 编码器2零脉冲缺失
    Alarm_0508:BOOL;   // 编码器1信号极性错误
    Alarm_0509:BOOL;   // 编码器2信号极性错误
    Alarm_0510:BOOL;   // 编码器1通讯故障
    Alarm_0511:BOOL;   // 编码器2通讯故障
    Alarm_0512:BOOL;   // 编码器1参数配置错误
    Alarm_0513:BOOL;   // 编码器2参数配置错误
    Alarm_0514:BOOL;   // 编码器1超速
    Alarm_0515:BOOL;   // 编码器2超速

    // ============================================================
    // 故障代码组 (F-codes)
    // ============================================================
    Fault_0001:BOOL;   // 电机过温 (Motor overtemperature)
    Fault_0002:BOOL;   // 功率单元过温 (Power unit overtemperature)
    Fault_0003:BOOL;   // 直流母线过压 (DC link overvoltage)
    Fault_0004:BOOL;   // 直流母线欠压 (DC link undervoltage)
    Fault_0005:BOOL;   // 电机I2t过载 (Motor I2t overload)
    Fault_0006:BOOL;   // 功率单元I2t过载 (Power unit I2t overload)
    Fault_0009:BOOL;   // 功率元件超温 (Excess temperature power component)
    Fault_0011:BOOL;   // 电机堵转 (Motor blocked)
    Fault_0012:BOOL;   // 电机温度传感器故障 (Motor temp sensor fault)
    Fault_0015:BOOL;   // 外部故障1 (External fault 1)
    Fault_0021:BOOL;   // 电机接地故障 (Ground fault motor)
    Fault_0030:BOOL;   // 冷却风机故障 (Cooling fan failure)
    Fault_0035:BOOL;   // 功率单元故障 (Power unit failed)
    Fault_0036:BOOL;   // 功率单元内部故障 (Fault in power unit)
    Fault_0041:BOOL;   // 编码器1故障 (Encoder 1 faulty)
    Fault_0042:BOOL;   // 速度偏差超限 (Speed deviation)
    Fault_0044:BOOL;   // 速度控制器阈值超限 (Speed ctrl threshold exceeded)
    Fault_0052:BOOL;   // 功率元件故障 (Power component failed)
    Fault_0054:BOOL;   // IPD故障 (IPD failed)
    Fault_0060:BOOL;   // 通讯故障 (Communication error)
    Fault_0061:BOOL;   // PROFIBUS通讯故障
    Fault_0062:BOOL;   // CAN通讯故障
    Fault_0063:BOOL;   // USS通讯故障
    Fault_0064:BOOL;   // 编码器通讯故障
    Fault_0065:BOOL;   // 模拟量输入故障
    Fault_0066:BOOL;   // 数字量输入故障
    Fault_0070:BOOL;   // 参数设置故障
    Fault_0071:BOOL;   // 参数EEPROM故障
    Fault_0072:BOOL;   // 参数RAM故障
    Fault_0073:BOOL;   // 参数校验错误
    Fault_0074:BOOL;   // 参数范围超限
    Fault_0075:BOOL;   // 参数兼容性错误
    Fault_0076:BOOL;   // 参数依赖关系错误
    Fault_0077:BOOL;   // 参数值无效
    Fault_0078:BOOL;   // 参数写入被禁止
    Fault_0079:BOOL;   // 参数计算错误
    Fault_0080:BOOL;   // 参数数量超限
    Fault_0085:BOOL;   // 电机数据识别故障
    Fault_0090:BOOL;   // 速度设定值故障
    Fault_0100:BOOL;   // 转矩设定值故障

    // ============================================================
    // 名称说明字符串组（供HMI显示，可按需扩展）
    // ============================================================
    // 说明：每个字符串与对应bool变量一一对应，HMI可根据bool状态
    //       读取相应字符串显示报警/故障名称。
    //       字符串长度限制为STRING[32]，共约64字节。
    Name_Alarm_0500:STRING[32];   // '编码器1信号丢失'
    Name_Alarm_0501:STRING[32];   // '编码器2信号丢失'
    Name_Alarm_0502:STRING[32];   // '编码器1信号幅值过低'
    Name_Alarm_0503:STRING[32];   // '编码器2信号幅值过低'
    Name_Alarm_0504:STRING[32];   // '编码器1信号频率超限'
    Name_Alarm_0505:STRING[32];   // '编码器2信号频率超限'
    Name_Alarm_0506:STRING[32];   // '编码器1零脉冲缺失'
    Name_Alarm_0507:STRING[32];   // '编码器2零脉冲缺失'
    Name_Alarm_0508:STRING[32];   // '编码器1信号极性错误'
    Name_Alarm_0509:STRING[32];   // '编码器2信号极性错误'
    Name_Alarm_0510:STRING[32];   // '编码器1通讯故障'
    Name_Alarm_0511:STRING[32];   // '编码器2通讯故障'
    Name_Alarm_0512:STRING[32];   // '编码器1参数配置错误'
    Name_Alarm_0513:STRING[32];   // '编码器2参数配置错误'
    Name_Alarm_0514:STRING[32];   // '编码器1超速'
    Name_Alarm_0515:STRING[32];   // '编码器2超速'

    Name_Fault_0001:STRING[32];   // '电机过温'
    Name_Fault_0002:STRING[32];   // '功率单元过温'
    Name_Fault_0003:STRING[32];   // '直流母线过压'
    Name_Fault_0004:STRING[32];   // '直流母线欠压'
    Name_Fault_0005:STRING[32];   // '电机I2t过载'
    Name_Fault_0006:STRING[32];   // '功率单元I2t过载'
    Name_Fault_0009:STRING[32];   // '功率元件超温'
    Name_Fault_0011:STRING[32];   // '电机堵转'
    Name_Fault_0012:STRING[32];   // '电机温度传感器故障'
    Name_Fault_0015:STRING[32];   // '外部故障1'
    Name_Fault_0021:STRING[32];   // '电机接地故障'
    Name_Fault_0030:STRING[32];   // '冷却风机故障'
    Name_Fault_0035:STRING[32];   // '功率单元故障'
    Name_Fault_0036:STRING[32];   // '功率单元内部故障'
    Name_Fault_0041:STRING[32];   // '编码器1故障'
    Name_Fault_0042:STRING[32];   // '速度偏差超限'
    Name_Fault_0044:STRING[32];   // '速度控制器阈值超限'
    Name_Fault_0052:STRING[32];   // '功率元件故障'
    Name_Fault_0054:STRING[32];   // 'IPD故障'
    Name_Fault_0060:STRING[32];   // '通讯故障'
    Name_Fault_0061:STRING[32];   // 'PROFIBUS通讯故障'
    Name_Fault_0062:STRING[32];   // 'CAN通讯故障'
    Name_Fault_0063:STRING[32];   // 'USS通讯故障'
    Name_Fault_0064:STRING[32];   // '编码器通讯故障'
    Name_Fault_0065:STRING[32];   // '模拟量输入故障'
    Name_Fault_0066:STRING[32];   // '数字量输入故障'
    Name_Fault_0070:STRING[32];   // '参数设置故障'
    Name_Fault_0071:STRING[32];   // '参数EEPROM故障'
    Name_Fault_0072:STRING[32];   // '参数RAM故障'
    Name_Fault_0073:STRING[32];   // '参数校验错误'
    Name_Fault_0074:STRING[32];   // '参数范围超限'
    Name_Fault_0075:STRING[32];   // '参数兼容性错误'
    Name_Fault_0076:STRING[32];   // '参数依赖关系错误'
    Name_Fault_0077:STRING[32];   // '参数值无效'
    Name_Fault_0078:STRING[32];   // '参数写入被禁止'
    Name_Fault_0079:STRING[32];   // '参数计算错误'
    Name_Fault_0080:STRING[32];   // '参数数量超限'
    Name_Fault_0085:STRING[32];   // '电机数据识别故障'
    Name_Fault_0090:STRING[32];   // '速度设定值故障'
    Name_Fault_0100:STRING[32];   // '转矩设定值故障'
END_STRUCT

BEGIN
    // ============================================================
    // 初始化报警代码名称字符串
    // ============================================================
    Name_Alarm_0500:='编码器1信号丢失';
    Name_Alarm_0501:='编码器2信号丢失';
    Name_Alarm_0502:='编码器1信号幅值过低';
    Name_Alarm_0503:='编码器2信号幅值过低';
    Name_Alarm_0504:='编码器1信号频率超限';
    Name_Alarm_0505:='编码器2信号频率超限';
    Name_Alarm_0506:='编码器1零脉冲缺失';
    Name_Alarm_0507:='编码器2零脉冲缺失';
    Name_Alarm_0508:='编码器1信号极性错误';
    Name_Alarm_0509:='编码器2信号极性错误';
    Name_Alarm_0510:='编码器1通讯故障';
    Name_Alarm_0511:='编码器2通讯故障';
