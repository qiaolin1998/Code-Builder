    Name_Fault_0060:='通讯故障';
    Name_Fault_0061:='PROFIBUS通讯故障';
    Name_Fault_0062:='CAN通讯故障';
    Name_Fault_0063:='USS通讯故障';
    Name_Fault_0064:='编码器通讯故障';
    Name_Fault_0065:='模拟量输入故障';
    Name_Fault_0066:='数字量输入故障';
    Name_Fault_0070:='参数设置故障';
    Name_Fault_0071:='参数EEPROM故障';
