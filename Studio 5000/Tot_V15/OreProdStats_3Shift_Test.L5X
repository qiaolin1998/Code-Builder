<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="1">
<![CDATA[// AOI 名称: OreProdStats_3Shift_Test (三班制产量统计测试系统)]]>
</Line>
<Line Number="2">
<![CDATA[// 版本: 1.0]]>
</Line>
<Line Number="3">
<![CDATA[// 编程语言: Structured Text (ST)]]>
</Line>
<Line Number="4">
<![CDATA[// 适用平台: Studio 5000 (ControlLogix/CompactLogix)]]>
</Line>
<Line Number="5">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="6">
<![CDATA[// 功能概述:]]>
</Line>
<Line Number="7">
<![CDATA[// 1. 自动化测试 OreProdStats_3Shift AOI 的各项功能]]>
</Line>
<Line Number="8">
<![CDATA[// 2. 模拟不同时间场景和输入条件]]>
</Line>
<Line Number="9">
<![CDATA[// 3. 验证班次切换、累计逻辑、边界条件等]]>
</Line>
<Line Number="10">
<![CDATA[// 4. 提供详细的测试结果和错误报告]]>
</Line>
<Line Number="11">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="12">
<![CDATA[// 测试模式说明:]]>
</Line>
<Line Number="13">
<![CDATA[// 0 = 基础功能测试: 脉冲累计、使能控制]]>
</Line>
<Line Number="14">
<![CDATA[// 1 = 班次切换测试: 早班->中班->晚班->早班]]>
</Line>
<Line Number="15">
<![CDATA[// 2 = 2小时时段测试: 验证各时段累计正确性]]>
</Line>
<Line Number="16">
<![CDATA[// 3 = 边界条件测试: 跨午夜、月末、闰年等]]>
</Line>
<Line Number="17">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[// 初始化]]>
</Line>
<Line Number="20">
<![CDATA[// 初始化
IF EnableIn AND (Test_Step = 0) THEN
    Test_Passed := FALSE;
    Test_Failed := FALSE;
    Test_Count := 0;
    Failed_Count := 0;
    Test_Message_Code := 0;
    Test_Step := 1;
    Test_Timer.PRE := 1000;  // 1秒测试间隔
    Test_Counter := 0;
END_IF;]]>
</Line>
<Line Number="24">
<![CDATA[    Test_Result.Failed_Count := 0;]]>
</Line>
<Line Number="25">
<![CDATA[    Test_Message_Code := 0;]]>
</Line>
<Line Number="26">
<![CDATA[    Test_Step := 1;]]>
</Line>
<Line Number="27">
<![CDATA[    Test_Timer.PRE := 1000;  // 1秒测试间隔]]>
</Line>
<Line Number="28">
<![CDATA[    Test_Counter := 0;]]>
</Line>
<Line Number="29">
<![CDATA[END_IF;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[// 测试定时器]]>
</Line>
<Line Number="32">
<![CDATA[Test_Timer.TimerEnable := EnableIn;]]>
</Line>
<Line Number="33">
<![CDATA[Test_Timer.Reset := Test_Timer.DN;]]>
</Line>
<Line Number="34">
<![CDATA[TONR(Test_Timer);]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[// 主测试逻辑]]>
</Line>
<Line Number="37">
<![CDATA[IF EnableIn AND Test_Timer.DN THEN]]>
</Line>
<Line Number="38">
<![CDATA[    Test_Result.Test_Count := Test_Result.Test_Count + 1;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[    CASE Test_Mode OF]]>
</Line>
<Line Number="41">
<![CDATA[        0: // 基础功能测试]]>
</Line>
<Line Number="42">
<![CDATA[            Run_Basic_Test();]]>
</Line>
<Line Number="43">
<![CDATA[        1: // 班次切换测试]]>
</Line>
<Line Number="44">
<![CDATA[            Run_Shift_Test();]]>
</Line>
<Line Number="45">
<![CDATA[        2: // 2小时时段测试]]>
</Line>
<Line Number="46">
<![CDATA[            Run_Section_Test();]]>
</Line>
<Line Number="47">
<![CDATA[        3: // 边界条件测试]]>
</Line>
<Line Number="48">
<![CDATA[            Run_Boundary_Test();]]>
</Line>
<Line Number="49">
<![CDATA[    END_CASE;]]>
</Line>
<Line Number="50">
<![CDATA[END_IF;]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[// 测试完成处理]]>
</Line>
<Line Number="53">
<![CDATA[IF Test_Step = 999 THEN]]>
</Line>
<Line Number="54">
<![CDATA[    IF Test_Result.Failed_Count = 0 THEN]]>
</Line>
<Line Number="55">
<![CDATA[        Test_Result.Test_Passed := TRUE;]]>
</Line>
<Line Number="56">
<![CDATA[        Test_Message_Code := 1;]]>
</Line>
<Line Number="57">
<![CDATA[    ELSE]]>
</Line>
<Line Number="58">
<![CDATA[        Test_Result.Test_Failed := TRUE;]]>
</Line>
<Line Number="59">
<![CDATA[        Test_Message_Code := 2;]]>
</Line>
<Line Number="60">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="61">
<![CDATA[END_IF;]]>
</Line>
<Line Number="62">
<![CDATA[]]>
</Line>
<Line Number="63">
<![CDATA[EnableOut := EnableIn;]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
<Line Number="65">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="66">
<![CDATA[// 基础功能测试]]>
</Line>
<Line Number="67">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[// 测试脉冲累计功能]]>
</Line>
<Line Number="70">
<![CDATA[IF Test_Step = 1 THEN]]>
</Line>
<Line Number="71">
<![CDATA[    Mock_Hour := 9;]]>
</Line>
<Line Number="72">
<![CDATA[    Mock_Minute := 0;]]>
</Line>
<Line Number="73">
<![CDATA[    Mock_Second := 0;]]>
</Line>
<Line Number="74">
<![CDATA[    Mock_Pulse := TRUE;]]>
</Line>
<Line Number="75">
<![CDATA[    Expected_Value := 100.0;]]>
</Line>
<Line Number="76">
<![CDATA[    Test_Step := 2;]]>
</Line>
<Line Number="77">
<![CDATA[END_IF;]]>
</Line>
<Line Number="78">
<![CDATA[]]>
</Line>
<Line Number="79">
