<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="1">
<![CDATA[// AOI 名称: TempAlarm16_L2 (16路温度测点二级超温报警批量处理)]]>
</Line>
<Line Number="2">
<![CDATA[// 版本: 1.0]]>
</Line>
<Line Number="3">
<![CDATA[// 编程语言: Structured Text (ST)]]>
</Line>
<Line Number="4">
<![CDATA[// 适用平台: Studio 5000 (ControlLogix/CompactLogix)]]>
</Line>
<Line Number="5">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="6">
<![CDATA[// 功能概述:]]>
</Line>
<Line Number="7">
<![CDATA[// 1. 对全部 16 路温度测点进行批量二级超温监视:]]>
</Line>
<Line Number="8">
<![CDATA[//      一级报警(预警/高报)   -> 提示值班人员介入处理;]]>
</Line>
<Line Number="9">
<![CDATA[//      二级报警(停机/高高报) -> 驱动停机联锁输出 Out_Trip;]]>
</Line>
<Line Number="10">
<![CDATA[// 2. 所有测点配置与状态均采用数组存储, 核心逻辑用一个 FOR 循环]]>
</Line>
<Line Number="11">
<![CDATA[//    统一处理, 16 路共用同一份代码, 无任何重复逻辑;]]>
</Line>
<Line Number="12">
<![CDATA[// 3. 每路独立配置: 使能 / 一级阈值 / 二级阈值 / 回差 / 一级延时 / 二级延时;]]>
</Line>
<Line Number="13">
<![CDATA[// 4. 全部报警通道统一具备:]]>
</Line>
<Line Number="14">
<![CDATA[//      - 回差过滤: 报警产生阈值 = SP, 解除阈值 = SP - Hys,]]>
</Line>
<Line Number="15">
<![CDATA[//        防止 PV 在阈值附近小幅波动时报警反复抖动;]]>
</Line>
<Line Number="16">
<![CDATA[//      - 延时防抖: 报警条件须连续成立达到设定延时后才真正置位,]]>
</Line>
<Line Number="17">
<![CDATA[//        瞬时尖峰/干扰不会误触发; 解除为立即动作(经回差判定);]]>
</Line>
<Line Number="18">
<![CDATA[// 5. 事件记录: 环形缓冲保存最近 32 条事件(报警产生/解除/参数修改),]]>
</Line>
<Line Number="19">
<![CDATA[//    含通道号、事件类型、当时 PV 与时标, 供 HMI 追溯;]]>
</Line>
<Line Number="20">
<![CDATA[// 6. 批量参数配置: HMI 可按"组"统一下发阈值/回差/延时,]]>
</Line>
<Line Number="21">
<![CDATA[//    写入前校验操作权限等级(User_Level >= 2 才允许修改);]]>
</Line>
<Line Number="22">
<![CDATA[// 7. 掉电保持: 全部配置与状态保存在 HMI_CMD(InOut) 对应的]]>
</Line>
<Line Number="23">
<![CDATA[//    控制器标签中, ControlLogix 标签值掉电保持, 重启后参数不丢失。]]>
</Line>
<Line Number="24">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="25">
<![CDATA[// 测点通道分配表(下标 0..15):]]>
</Line>
<Line Number="26">
<![CDATA[//   组1 电机定子温度(6点): 0=定子U1  1=定子V1  2=定子W1]]>
</Line>
<Line Number="27">
<![CDATA[//                          3=定子U2  4=定子V2  5=定子W2]]>
</Line>
<Line Number="28">
<![CDATA[//   组2 电机轴承温度(4点): 6=驱动端轴承  7=非驱动端轴承]]>
</Line>
<Line Number="29">
<![CDATA[//                          8=轴承3        9=轴承4]]>
</Line>
<Line Number="30">
<![CDATA[//   组3 渣浆泵轴承温度(4点): 10=泵轴承1  11=泵轴承2]]>
</Line>
<Line Number="31">
<![CDATA[//                            12=泵轴承3  13=泵轴承4]]>
</Line>
<Line Number="32">
<![CDATA[//   组4 减速机油温(2点):   14=油温1     15=油温2]]>
</Line>
<Line Number="33">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="34">
<![CDATA[// 默认整定值(首次上电自动写入, 之后可在 HMI 修改):]]>
</Line>
<Line Number="35">
<![CDATA[//   组1 定子:      SP1=130  SP2=145  Hys=3  Dly1=3s  Dly2=2s]]>
</Line>
<Line Number="36">
<![CDATA[//   组2 电机轴承:  SP1=85   SP2=95   Hys=3  Dly1=3s  Dly2=2s]]>
</Line>
<Line Number="37">
<![CDATA[//   组3 泵轴承:    SP1=80   SP2=90   Hys=3  Dly1=3s  Dly2=2s]]>
</Line>
<Line Number="38">
<![CDATA[//   组4 减速机油:  SP1=75   SP2=85   Hys=3  Dly1=3s  Dly2=2s]]>
</Line>
<Line Number="39">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="40">
<![CDATA[// 报警动作逻辑(单通道, 一级/二级结构相同):]]>
</Line>
<Line Number="41">
<![CDATA[//        产生: PV >= SP 且连续保持 Dly 秒  -> Alm = 1 (记录事件)]]>
</Line>
<Line Number="42">
<![CDATA[//        解除: PV <  SP - Hys (立即)       -> Alm = 0 (记录事件)]]>
</Line>
<Line Number="43">
<![CDATA[//   SP-Hys ──────┐]]>
</Line>
<Line Number="44">
<![CDATA[//                │ 解除区(回差带内保持原状态)]]>
</Line>
<Line Number="45">
<![CDATA[//   SP    ───────┴── 产生线]]>
</Line>
<Line Number="46">
<![CDATA[// 变量约定:]]>
</Line>
<Line Number="47">
<![CDATA[//   输入  : Hour / Minute / Second (DINT) -- 事件记录时标]]>
</Line>
<Line Number="48">
<![CDATA[//   输出  : Out_Warn(BOOL) 任一路一级报警总出口(预警)]]>
</Line>
<Line Number="49">
<![CDATA[//           Out_Trip(BOOL) 任一路二级报警总出口(停机联锁)]]>
</Line>
<Line Number="50">
<![CDATA[//   InOut : HMI_CMD - 详见 UDT 注释(PV/配置/状态/批量参数/事件记录)]]>
</Line>
<Line Number="51">
<![CDATA[//   本地  : Tmr1/Tmr2 TIMER[16] 每路独立的防抖定时器]]>
</Line>
<Line Number="52">
<![CDATA[//           PrevAlm1/PrevAlm2 BOOL[16] 报警状态边沿检测]]>
</Line>
<Line Number="53">
<![CDATA[//           i, GS, GE (DINT) / IsFirstScan (BOOL)]]>
</Line>
<Line Number="54">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="55">
<![CDATA[]]>
</Line>
<Line Number="56">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="57">
<![CDATA[// 功能段 1: 首次扫描初始化(写入默认整定值)]]>
</Line>
<Line Number="58">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="59">
<![CDATA[// 判据: 若某通道 Cfg_SP2 <= 0 视为"未整定", 按所属组写入默认值。]]>
</Line>
<Line Number="60">
<![CDATA[// 仅在上电后第一个扫描周期执行, 此后参数由 HMI 维护并掉电保持。]]>
</Line>
<Line Number="61">
<![CDATA[IF IsFirstScan THEN]]>
</Line>
<Line Number="62">
<![CDATA[    FOR i := 0 TO 15 DO]]>
</Line>
<Line Number="63">
<![CDATA[        IF HMI_CMD.Cfg_SP2[i] <= 0.0 THEN]]>
</Line>
<Line Number="64">
<![CDATA[            IF i <= 5 THEN]]>
</Line>
<Line Number="65">
<![CDATA[                HMI_CMD.Cfg_SP1[i] := 130.0;  HMI_CMD.Cfg_SP2[i] := 145.0;]]>
</Line>
<Line Number="66">
<![CDATA[            ELSIF i <= 9 THEN]]>
</Line>
<Line Number="67">
<![CDATA[                HMI_CMD.Cfg_SP1[i] := 85.0;   HMI_CMD.Cfg_SP2[i] := 95.0;]]>
</Line>
<Line Number="68">
<![CDATA[            ELSIF i <= 13 THEN]]>
</Line>
<Line Number="69">
<![CDATA[                HMI_CMD.Cfg_SP1[i] := 80.0;   HMI_CMD.Cfg_SP2[i] := 90.0;]]>
</Line>
<Line Number="70">
<![CDATA[            ELSE]]>
</Line>
<Line Number="71">
<![CDATA[                HMI_CMD.Cfg_SP1[i] := 75.0;   HMI_CMD.Cfg_SP2[i] := 85.0;]]>
</Line>
<Line Number="72">
<![CDATA[            END_IF;]]>
</Line>
<Line Number="73">
<![CDATA[            HMI_CMD.Cfg_Hys[i]  := 3.0;]]>
</Line>
<Line Number="74">
<![CDATA[            HMI_CMD.Cfg_Dly1[i] := 3;]]>
</Line>
<Line Number="75">
<![CDATA[            HMI_CMD.Cfg_Dly2[i] := 2;]]>
</Line>
<Line Number="76">
<![CDATA[            HMI_CMD.Cfg_Enable[i] := 1;]]>
</Line>
<Line Number="77">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="78">
<![CDATA[    END_FOR;]]>
</Line>
<Line Number="79">
<![CDATA[    IsFirstScan := 0;]]>
</Line>
<Line Number="80">
<![CDATA[END_IF;]]>
</Line>
<Line Number="81">
<![CDATA[]]>
</Line>
<Line Number="82">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="83">
<![CDATA[// 功能段 2: 批量参数写入(权限校验 + 按组下发)]]>
</Line>
<Line Number="84">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="85">
<![CDATA[// HMI 置位 Apply_Batch 发起批量修改:]]>
</Line>
<Line Number="86">
<![CDATA[//   B_Group 选择目标组: 0=全部16路 1=定子 2=电机轴承 3=泵轴承 4=减速机油]]>
</Line>
<Line Number="87">
<![CDATA[//   B_SP1/B_SP2/B_Hys/B_Dly1/B_Dly2 为统一下发的整定值]]>
</Line>
<Line Number="88">
<![CDATA[//   B_EnableOpt: 0=不修改使能 1=批量启用 2=批量禁用]]>
</Line>
<Line Number="89">
<![CDATA[// 安全规则:]]>
</Line>
<Line Number="90">
<![CDATA[//   - User_Level < 2 时拒绝写入(事件类型6: 越权操作);]]>
</Line>
<Line Number="91">
<![CDATA[//   - 合法性检查: 要求 SP2 > SP1 且 Hys >= 0, 防止误设颠倒阈值;]]>
</Line>
<Line Number="92">
<![CDATA[//   - 写入成功后记录事件(类型5), 便于参数修改审计追溯。]]>
</Line>
<Line Number="93">
<![CDATA[IF HMI_CMD.Apply_Batch THEN]]>
</Line>
<Line Number="94">
<![CDATA[    IF HMI_CMD.User_Level >= 2 THEN]]>
</Line>
<Line Number="95">
<![CDATA[        IF (HMI_CMD.B_SP2 > HMI_CMD.B_SP1) AND (HMI_CMD.B_Hys >= 0.0) THEN]]>
</Line>
<Line Number="96">
<![CDATA[]]>
</Line>
<Line Number="97">
<![CDATA[            // 由组号换算通道下标范围 [GS, GE]]]>
</Line>
<Line Number="98">
<![CDATA[            CASE HMI_CMD.B_Group OF]]>
</Line>
<Line Number="99">
<![CDATA[                1: GS := 0;   GE := 5;     // 电机定子]]>
</Line>
<Line Number="100">
<![CDATA[                2: GS := 6;   GE := 9;     // 电机轴承]]>
</Line>
<Line Number="101">
<![CDATA[                3: GS := 10;  GE := 13;    // 渣浆泵轴承]]>
</Line>
<Line Number="102">
<![CDATA[                4: GS := 14;  GE := 15;    // 减速机油]]>
</Line>
<Line Number="103">
<![CDATA[                ELSE GS := 0; GE := 15;    // 0 及其他: 全部]]>
</Line>
<Line Number="104">
<![CDATA[            END_CASE;]]>
</Line>
<Line Number="105">
<![CDATA[]]>
</Line>
<Line Number="106">
<![CDATA[            FOR i := GS TO GE DO]]>
</Line>
<Line Number="107">
<![CDATA[                HMI_CMD.Cfg_SP1[i] := HMI_CMD.B_SP1;]]>
</Line>
<Line Number="108">
<![CDATA[                HMI_CMD.Cfg_SP2[i] := HMI_CMD.B_SP2;]]>
</Line>
<Line Number="109">
<![CDATA[                HMI_CMD.Cfg_Hys[i] := HMI_CMD.B_Hys;]]>
</Line>
<Line Number="110">
<![CDATA[                HMI_CMD.Cfg_Dly1[i] := HMI_CMD.B_Dly1;]]>
</Line>
<Line Number="111">
<![CDATA[                HMI_CMD.Cfg_Dly2[i] := HMI_CMD.B_Dly2;]]>
</Line>
<Line Number="112">
<![CDATA[                IF HMI_CMD.B_EnableOpt = 1 THEN]]>
</Line>
<Line Number="113">
<![CDATA[                    HMI_CMD.Cfg_Enable[i] := 1;]]>
</Line>
<Line Number="114">
<![CDATA[                ELSIF HMI_CMD.B_EnableOpt = 2 THEN]]>
</Line>
<Line Number="115">
<![CDATA[                    HMI_CMD.Cfg_Enable[i] := 0;]]>
</Line>
<Line Number="116">
<![CDATA[                END_IF;]]>
</Line>
<Line Number="117">
<![CDATA[            END_FOR;]]>
</Line>
<Line Number="118">
<![CDATA[]]>
</Line>
<Line Number="119">
<![CDATA[            // 事件: 类型5 = 批量参数修改成功 (Evt_Ch 记录目标组号)]]>
</Line>
<Line Number="120">
<![CDATA[            HMI_CMD.Evt_Ch[HMI_CMD.Evt_Head]   := HMI_CMD.B_Group;]]>
</Line>
<Line Number="121">
<![CDATA[            HMI_CMD.Evt_Type[HMI_CMD.Evt_Head] := 5;]]>
</Line>
<Line Number="122">
<![CDATA[            HMI_CMD.Evt_PV[HMI_CMD.Evt_Head]   := 0.0;]]>
</Line>
<Line Number="123">
<![CDATA[            HMI_CMD.Evt_H[HMI_CMD.Evt_Head]    := Hour;]]>
</Line>
<Line Number="124">
<![CDATA[            HMI_CMD.Evt_M[HMI_CMD.Evt_Head]    := Minute;]]>
</Line>
<Line Number="125">
<![CDATA[            HMI_CMD.Evt_S[HMI_CMD.Evt_Head]    := Second;]]>
</Line>
<Line Number="126">
<![CDATA[            HMI_CMD.Evt_Head := (HMI_CMD.Evt_Head + 1) MOD 32;]]>
</Line>
<Line Number="127">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="128">
<![CDATA[    ELSE]]>
</Line>
<Line Number="129">
<![CDATA[        // 事件: 类型6 = 越权修改被拒绝]]>
</Line>
<Line Number="130">
<![CDATA[        HMI_CMD.Evt_Ch[HMI_CMD.Evt_Head]   := HMI_CMD.B_Group;]]>
</Line>
<Line Number="131">
<![CDATA[        HMI_CMD.Evt_Type[HMI_CMD.Evt_Head] := 6;]]>
</Line>
<Line Number="132">
<![CDATA[        HMI_CMD.Evt_PV[HMI_CMD.Evt_Head]   := 0.0;]]>
</Line>
<Line Number="133">
<![CDATA[        HMI_CMD.Evt_H[HMI_CMD.Evt_Head]    := Hour;]]>
</Line>
<Line Number="134">
<![CDATA[        HMI_CMD.Evt_M[HMI_CMD.Evt_Head]    := Minute;]]>
</Line>
<Line Number="135">
<![CDATA[        HMI_CMD.Evt_S[HMI_CMD.Evt_Head]    := Second;]]>
</Line>
<Line Number="136">
<![CDATA[        HMI_CMD.Evt_Head := (HMI_CMD.Evt_Head + 1) MOD 32;]]>
</Line>
<Line Number="137">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="138">
<![CDATA[    HMI_CMD.Apply_Batch := 0;]]>
</Line>
<Line Number="139">
<![CDATA[END_IF;]]>
</Line>
<Line Number="140">
<![CDATA[]]>
</Line>
<Line Number="141">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="142">
<![CDATA[// 功能段 3: 16 路报警核心批量处理(FOR 循环统一逻辑)]]>
</Line>
<Line Number="143">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="144">
<![CDATA[// 每路通道依次执行:]]>
</Line>
<Line Number="145">
<![CDATA[//   1) 使能判断: 禁用通道强制解除报警并复位定时器;]]>
</Line>
<Line Number="146">
<![CDATA[//   2) 一级报警: 条件(PV>=SP1)驱动 TON 防抖, 延时到后置位;]]>
</Line>
<Line Number="147">
<![CDATA[//                 PV < SP1-Hys 时立即解除(回差);]]>
</Line>
<Line Number="148">
<![CDATA[//   3) 二级报警: 与一级同构, 但使用 SP2/Dly2;]]>
</Line>
<Line Number="149">
<![CDATA[//   4) 边沿检测: 置位/解除瞬间写入事件环形缓冲(类型1..4)。]]>
</Line>
<Line Number="150">
<![CDATA[// 说明: 每路使用独立的 Tmr1[i]/Tmr2[i] 与 PrevAlm*[i],]]>
</Line>
<Line Number="151">
<![CDATA[//       16 路互不影响, 任何一路动作不改变其余通道状态。]]>
</Line>
<Line Number="152">
<![CDATA[FOR i := 0 TO 15 DO]]>
</Line>
<Line Number="153">
<![CDATA[]]>
</Line>
<Line Number="154">
<![CDATA[    // ---------- 通道禁用时: 强制安全状态 ----------]]>
</Line>
<Line Number="155">
<![CDATA[    IF NOT HMI_CMD.Cfg_Enable[i] THEN]]>
</Line>
<Line Number="156">
<![CDATA[        HMI_CMD.Sta_Alm1[i] := 0;]]>
</Line>
<Line Number="157">
<![CDATA[        HMI_CMD.Sta_Alm2[i] := 0;]]>
</Line>
<Line Number="158">
<![CDATA[        Tmr1[i].TimerEnable := 0;]]>
</Line>
<Line Number="159">
<![CDATA[        Tmr1[i].PRE := 0;]]>
</Line>
<Line Number="160">
<![CDATA[        TON(Tmr1[i]);]]>
</Line>
<Line Number="161">
<![CDATA[        Tmr2[i].TimerEnable := 0;]]>
</Line>
<Line Number="162">
<![CDATA[        Tmr2[i].PRE := 0;]]>
</Line>
<Line Number="163">
<![CDATA[        TON(Tmr2[i]);]]>
</Line>
<Line Number="164">
<![CDATA[]]>
</Line>
<Line Number="165">
<![CDATA[    ELSE]]>
</Line>
<Line Number="166">
<![CDATA[        // ---------- 一级报警(预警) ----------]]>
</Line>
<Line Number="167">
<![CDATA[        // 防抖定时器: PV 连续 >= SP1 达到 Dly1 秒后 DN 置位]]>
</Line>
<Line Number="168">
<![CDATA[        Tmr1[i].PRE := HMI_CMD.Cfg_Dly1[i] * 1000;   // 秒 -> 毫秒]]>
</Line>
<Line Number="169">
<![CDATA[        Tmr1[i].TimerEnable := (HMI_CMD.PV[i] >= HMI_CMD.Cfg_SP1[i]);]]>
</Line>
<Line Number="170">
<![CDATA[        TON(Tmr1[i]);]]>
</Line>
<Line Number="171">
<![CDATA[]]>
</Line>
<Line Number="172">
<![CDATA[        // 回差解除: PV 跌回 SP1-Hys 以下, 立即解除并复位定时器]]>
</Line>
<Line Number="173">
<![CDATA[        IF HMI_CMD.PV[i] < (HMI_CMD.Cfg_SP1[i] - HMI_CMD.Cfg_Hys[i]) THEN]]>
</Line>
<Line Number="174">
<![CDATA[            HMI_CMD.Sta_Alm1[i] := 0;]]>
</Line>
<Line Number="175">
<![CDATA[            Tmr1[i].TimerEnable := 0;]]>
</Line>
<Line Number="176">
<![CDATA[            TON(Tmr1[i]);]]>
</Line>
<Line Number="177">
<![CDATA[        ELSIF Tmr1[i].DN THEN]]>
</Line>
<Line Number="178">
<![CDATA[            HMI_CMD.Sta_Alm1[i] := 1;]]>
</Line>
<Line Number="179">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="180">
<![CDATA[]]>
</Line>
<Line Number="181">
<![CDATA[        // ---------- 二级报警(停机) ----------]]>
</Line>
<Line Number="182">
<![CDATA[        Tmr2[i].PRE := HMI_CMD.Cfg_Dly2[i] * 1000;]]>
</Line>
<Line Number="183">
<![CDATA[        Tmr2[i].TimerEnable := (HMI_CMD.PV[i] >= HMI_CMD.Cfg_SP2[i]);]]>
</Line>
<Line Number="184">
<![CDATA[        TON(Tmr2[i]);]]>
</Line>
<Line Number="185">
<![CDATA[]]>
</Line>
<Line Number="186">
<![CDATA[        IF HMI_CMD.PV[i] < (HMI_CMD.Cfg_SP2[i] - HMI_CMD.Cfg_Hys[i]) THEN]]>
</Line>
<Line Number="187">
<![CDATA[            HMI_CMD.Sta_Alm2[i] := 0;]]>
</Line>
<Line Number="188">
<![CDATA[            Tmr2[i].TimerEnable := 0;]]>
</Line>
<Line Number="189">
<![CDATA[            TON(Tmr2[i]);]]>
</Line>
<Line Number="190">
<![CDATA[        ELSIF Tmr2[i].DN THEN]]>
</Line>
<Line Number="191">
<![CDATA[            HMI_CMD.Sta_Alm2[i] := 1;]]>
</Line>
<Line Number="192">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="193">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="194">
<![CDATA[]]>
</Line>
<Line Number="195">
<![CDATA[    // ---------- 事件记录: 边沿检测(类型1..4) ----------]]>
</Line>
<Line Number="196">
<![CDATA[    // 类型1=一级产生 2=一级解除 3=二级产生 4=二级解除]]>
</Line>
<Line Number="197">
<![CDATA[    IF HMI_CMD.Sta_Alm1[i] AND NOT PrevAlm1[i] THEN]]>
</Line>
<Line Number="198">
<![CDATA[        HMI_CMD.Evt_Ch[HMI_CMD.Evt_Head]   := i;]]>
</Line>
<Line Number="199">
<![CDATA[        HMI_CMD.Evt_Type[HMI_CMD.Evt_Head] := 1;]]>
</Line>
<Line Number="200">
<![CDATA[        HMI_CMD.Evt_PV[HMI_CMD.Evt_Head]   := HMI_CMD.PV[i];]]>
</Line>
<Line Number="201">
<![CDATA[        HMI_CMD.Evt_H[HMI_CMD.Evt_Head]    := Hour;]]>
</Line>
<Line Number="202">
<![CDATA[        HMI_CMD.Evt_M[HMI_CMD.Evt_Head]    := Minute;]]>
</Line>
<Line Number="203">
<![CDATA[        HMI_CMD.Evt_S[HMI_CMD.Evt_Head]    := Second;]]>
</Line>
<Line Number="204">
<![CDATA[        HMI_CMD.Evt_Head := (HMI_CMD.Evt_Head + 1) MOD 32;]]>
</Line>
<Line Number="205">
<![CDATA[    ELSIF (NOT HMI_CMD.Sta_Alm1[i]) AND PrevAlm1[i] THEN]]>
</Line>
<Line Number="206">
<![CDATA[        HMI_CMD.Evt_Ch[HMI_CMD.Evt_Head]   := i;]]>
</Line>
<Line Number="207">
<![CDATA[        HMI_CMD.Evt_Type[HMI_CMD.Evt_Head] := 2;]]>
</Line>
<Line Number="208">
<![CDATA[        HMI_CMD.Evt_PV[HMI_CMD.Evt_Head]   := HMI_CMD.PV[i];]]>
</Line>
<Line Number="209">
<![CDATA[        HMI_CMD.Evt_H[HMI_CMD.Evt_Head]    := Hour;]]>
</Line>
<Line Number="210">
<![CDATA[        HMI_CMD.Evt_M[HMI_CMD.Evt_Head]    := Minute;]]>
</Line>
<Line Number="211">
<![CDATA[        HMI_CMD.Evt_S[HMI_CMD.Evt_Head]    := Second;]]>
</Line>
<Line Number="212">
<![CDATA[        HMI_CMD.Evt_Head := (HMI_CMD.Evt_Head + 1) MOD 32;]]>
</Line>
<Line Number="213">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="214">
<![CDATA[]]>
</Line>
<Line Number="215">
<![CDATA[    IF HMI_CMD.Sta_Alm2[i] AND NOT PrevAlm2[i] THEN]]>
</Line>
<Line Number="216">
<![CDATA[        HMI_CMD.Evt_Ch[HMI_CMD.Evt_Head]   := i;]]>
</Line>
<Line Number="217">
<![CDATA[        HMI_CMD.Evt_Type[HMI_CMD.Evt_Head] := 3;]]>
</Line>
<Line Number="218">
<![CDATA[        HMI_CMD.Evt_PV[HMI_CMD.Evt_Head]   := HMI_CMD.PV[i];]]>
</Line>
<Line Number="219">
<![CDATA[        HMI_CMD.Evt_H[HMI_CMD.Evt_Head]    := Hour;]]>
</Line>
<Line Number="220">
<![CDATA[        HMI_CMD.Evt_M[HMI_CMD.Evt_Head]    := Minute;]]>
</Line>
<Line Number="221">
<![CDATA[        HMI_CMD.Evt_S[HMI_CMD.Evt_Head]    := Second;]]>
</Line>
<Line Number="222">
<![CDATA[        HMI_CMD.Evt_Head := (HMI_CMD.Evt_Head + 1) MOD 32;]]>
</Line>
<Line Number="223">
<![CDATA[    ELSIF (NOT HMI_CMD.Sta_Alm2[i]) AND PrevAlm2[i] THEN]]>
</Line>
<Line Number="224">
<![CDATA[        HMI_CMD.Evt_Ch[HMI_CMD.Evt_Head]   := i;]]>
</Line>
<Line Number="225">
<![CDATA[        HMI_CMD.Evt_Type[HMI_CMD.Evt_Head] := 4;]]>
</Line>
<Line Number="226">
<![CDATA[        HMI_CMD.Evt_PV[HMI_CMD.Evt_Head]   := HMI_CMD.PV[i];]]>
</Line>
<Line Number="227">
<![CDATA[        HMI_CMD.Evt_H[HMI_CMD.Evt_Head]    := Hour;]]>
</Line>
<Line Number="228">
<![CDATA[        HMI_CMD.Evt_M[HMI_CMD.Evt_Head]    := Minute;]]>
</Line>
<Line Number="229">
<![CDATA[        HMI_CMD.Evt_S[HMI_CMD.Evt_Head]    := Second;]]>
</Line>
<Line Number="230">
<![CDATA[        HMI_CMD.Evt_Head := (HMI_CMD.Evt_Head + 1) MOD 32;]]>
</Line>
<Line Number="231">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="232">
<![CDATA[]]>
</Line>
<Line Number="233">
<![CDATA[    PrevAlm1[i] := HMI_CMD.Sta_Alm1[i];]]>
</Line>
<Line Number="234">
<![CDATA[    PrevAlm2[i] := HMI_CMD.Sta_Alm2[i];]]>
</Line>
<Line Number="235">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="236">
<![CDATA[]]>
</Line>
<Line Number="237">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="238">
<![CDATA[// 功能段 4: 报警汇总与停机输出]]>
</Line>
<Line Number="239">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="240">
<![CDATA[// 统计当前处于一级/二级报警的通道数, 并生成两个总出口:]]>
</Line>
<Line Number="241">
<![CDATA[//   Out_Warn: >=1 路一级报警 -> 接 HMI 声光预警;]]>
</Line>
<Line Number="242">
<![CDATA[//   Out_Trip: >=1 路二级报警 -> 接停机联锁回路。]]>
</Line>
<Line Number="243">
<![CDATA[HMI_CMD.Alm1_Count := 0;]]>
</Line>
<Line Number="244">
<![CDATA[HMI_CMD.Alm2_Count := 0;]]>
</Line>
<Line Number="245">
<![CDATA[FOR i := 0 TO 15 DO]]>
</Line>
<Line Number="246">
<![CDATA[    IF HMI_CMD.Sta_Alm1[i] THEN]]>
</Line>
<Line Number="247">
<![CDATA[        HMI_CMD.Alm1_Count := HMI_CMD.Alm1_Count + 1;]]>
</Line>
<Line Number="248">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="249">
<![CDATA[    IF HMI_CMD.Sta_Alm2[i] THEN]]>
</Line>
<Line Number="250">
<![CDATA[        HMI_CMD.Alm2_Count := HMI_CMD.Alm2_Count + 1;]]>
</Line>
<Line Number="251">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="252">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="253">
<![CDATA[]]>
</Line>
<Line Number="254">
<![CDATA[HMI_CMD.Any_Alm1 := (HMI_CMD.Alm1_Count > 0);]]>
</Line>
<Line Number="255">
<![CDATA[HMI_CMD.Any_Alm2 := (HMI_CMD.Alm2_Count > 0);]]>
</Line>
<Line Number="256">
<![CDATA[Out_Warn := HMI_CMD.Any_Alm1;]]>
</Line>
<Line Number="257">
<![CDATA[Out_Trip := HMI_CMD.Any_Alm2;]]>
</Line>
<Line Number="258">
<![CDATA[]]>
</Line>
<Line Number="259">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="260">
<![CDATA[// 功能段 5: 事件记录清空命令]]>
</Line>
<Line Number="261">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="262">
<![CDATA[// HMI 置位 Reset_Log 时清空环形缓冲与写指针, 用于检修后重新起录。]]>
</Line>
<Line Number="263">
<![CDATA[IF HMI_CMD.Reset_Log THEN]]>
</Line>
<Line Number="264">
<![CDATA[    FOR i := 0 TO 31 DO]]>
</Line>
<Line Number="265">
<![CDATA[        HMI_CMD.Evt_Ch[i]   := 0;]]>
</Line>
<Line Number="266">
<![CDATA[        HMI_CMD.Evt_Type[i] := 0;]]>
</Line>
<Line Number="267">
<![CDATA[        HMI_CMD.Evt_PV[i]   := 0.0;]]>
</Line>
<Line Number="268">
<![CDATA[        HMI_CMD.Evt_H[i]    := 0;]]>
</Line>
<Line Number="269">
<![CDATA[        HMI_CMD.Evt_M[i]    := 0;]]>
</Line>
<Line Number="270">
<![CDATA[        HMI_CMD.Evt_S[i]    := 0;]]>
</Line>
<Line Number="271">
<![CDATA[    END_FOR;]]>
</Line>
<Line Number="272">
<![CDATA[    HMI_CMD.Evt_Head := 0;]]>
</Line>
<Line Number="273">
<![CDATA[    HMI_CMD.Reset_Log := 0;]]>
</Line>
<Line Number="274">
<![CDATA[END_IF;]]>
</Line>
<Line Number="275">
<![CDATA[]]>
</Line>
<Line Number="276">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="277">
<![CDATA[// 功能段 6: 启用状态输出]]>
</Line>
<Line Number="278">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="279">
<![CDATA[// EnableOut 跟随 EnableIn, 用于在梯形图中级联使能]]>
</Line>
<Line Number="280">
<![CDATA[EnableOut := EnableIn;]]>
</Line>
<Line Number="281">
<![CDATA[]]>
</Line>
<Line Number="282">
