<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.00" TargetName="TempAlarm16_L2" TargetType="AddOnInstructionDefinition" TargetRevision="1.0 " TargetLastEdited="2026-10-20T00:00:00.000Z" ContainsContext="true" ExportDate="Tue Oct 20 00:00:00 2026" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding AllProjDocTrans">
<Controller Use="Context" Name="TempAlarm16_L2">
<DataTypes Use="Context">
<DataType Name="TempAlarm16_L2_Type" Family="NoFamily" Class="User">
<Members>
<Member Name="ZZZZZZZZZZTempAlarm16_L20" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/>
<Member Name="Apply_Batch" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZTempAlarm16_L20" BitNumber="0" ExternalAccess="Read/Write">
<Description>
<![CDATA[批量参数写入命令(点动置位, 处理完自动复位)]]>
</Description>
</Member>
<Member Name="Reset_Log" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZTempAlarm16_L20" BitNumber="1" ExternalAccess="Read/Write">
<Description>
<![CDATA[清空事件记录命令(点动置位, 处理完自动复位)]]>
</Description>
</Member>
<Member Name="PV" DataType="REAL" Dimension="16" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[16路实时温度(由模拟量换算程序写入)]]>
</Description>
</Member>
<Member Name="Cfg_Enable" DataType="BOOL" Dimension="16" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[各通道使能(1=投入 0=退出)]]>
</Description>
</Member>
<Member Name="Cfg_SP1" DataType="REAL" Dimension="16" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[一级报警阈值(预警/高报)]]>
</Description>
</Member>
<Member Name="Cfg_SP2" DataType="REAL" Dimension="16" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[二级报警阈值(停机/高高报)]]>
</Description>
</Member>
<Member Name="Cfg_Hys" DataType="REAL" Dimension="16" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[回差值(解除阈值=SP-Hys)]]>
</Description>
</Member>
<Member Name="Cfg_Dly1" DataType="DINT" Dimension="16" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[一级报警防抖延时(秒)]]>
</Description>
</Member>
<Member Name="Cfg_Dly2" DataType="DINT" Dimension="16" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[二级报警防抖延时(秒)]]>
</Description>
</Member>
<Member Name="Sta_Alm1" DataType="BOOL" Dimension="16" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[一级报警状态(1=报警中)]]>
</Description>
</Member>
<Member Name="Sta_Alm2" DataType="BOOL" Dimension="16" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[二级报警状态(1=报警中)]]>
</Description>
</Member>
<Member Name="Any_Alm1" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[任一路一级报警总标志]]>
</Description>
</Member>
<Member Name="Any_Alm2" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[任一路二级报警总标志]]>
</Description>
</Member>
<Member Name="Alm1_Count" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[当前一级报警通道数]]>
</Description>
</Member>
<Member Name="Alm2_Count" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[当前二级报警通道数]]>
</Description>
</Member>
<Member Name="User_Level" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[当前操作员权限等级(>=2允许修改参数)]]>
</Description>
</Member>
<Member Name="B_Group" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[批量目标组(0=全部 1=定子 2=电机轴承 3=泵轴承 4=减速机油)]]>
</Description>
</Member>
<Member Name="B_SP1" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[批量下发: 一级阈值]]>
</Description>
</Member>
<Member Name="B_SP2" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[批量下发: 二级阈值]]>
</Description>
</Member>
<Member Name="B_Hys" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[批量下发: 回差值]]>
</Description>
</Member>
<Member Name="B_Dly1" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[批量下发: 一级延时(秒)]]>
</Description>
</Member>
<Member Name="B_Dly2" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[批量下发: 二级延时(秒)]]>
</Description>
</Member>
<Member Name="B_EnableOpt" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[批量使能选项(0=不修改 1=全部启用 2=全部禁用)]]>
</Description>
</Member>
<Member Name="Evt_Head" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[事件环形缓冲写指针(0..31)]]>
</Description>
</Member>
<Member Name="Evt_Ch" DataType="DINT" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[事件通道号(参数事件记录组号)]]>
</Description>
</Member>
<Member Name="Evt_Type" DataType="DINT" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[事件类型(1=一级产生 2=一级解除 3=二级产生 4=二级解除 5=参数修改 6=越权拒绝)]]>
</Description>
</Member>
<Member Name="Evt_PV" DataType="REAL" Dimension="32" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[事件发生时的温度值]]>
</Description>
</Member>
<Member Name="Evt_H" DataType="DINT" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[事件时标-时]]>
</Description>
</Member>
<Member Name="Evt_M" DataType="DINT" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[事件时标-分]]>
</Description>
</Member>
<Member Name="Evt_S" DataType="DINT" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
