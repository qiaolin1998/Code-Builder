<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="1">
<![CDATA[// AOI 名称: FlowRateTot (流量累计系统)]]>
</Line>
<Line Number="2">
<![CDATA[// 版本: 1.0]]>
</Line>
<Line Number="3">
<![CDATA[// 编程语言: Structured Text (ST)]]>
</Line>
<Line Number="4">
<![CDATA[// 适用平台: Studio 5000 (ControlLogix/CompactLogix)]]>
</Line>
<Line Number="5">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="6">
<![CDATA[// 功能概述:]]>
</Line>
<Line Number="7">
<![CDATA[// 1. 根据流量计瞬时流量计算累计量,核心公式: 累计量 = 瞬时流量 × 时间间隔]]>
</Line>
<Line Number="8">
<![CDATA[// 2. 支持总累计、分钟累计、天累计、月累计]]>
</Line>
<Line Number="9">
<![CDATA[// 3. 增加流量有效性判断: 流量超出上下限范围时停止累计并输出报警]]>
</Line>
<Line Number="10">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="11">
<![CDATA[// 功能段 1: 流量有效性判断与积分增量计算]]>
</Line>
<Line Number="12">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[Is_Flow_Valid := (In_Flow_Rate >= In_Flow_Min) AND (In_Flow_Rate <= In_Flow_Max);]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[IF Is_Flow_Valid THEN]]>
</Line>
<Line Number="17">
<![CDATA[    Flow_Increment := In_Flow_Rate * In_Scan_Time / 3600000.0;]]>
</Line>
<Line Number="18">
<![CDATA[ELSE]]>
</Line>
<Line Number="19">
<![CDATA[    Flow_Increment := 0.0;]]>
</Line>
<Line Number="20">
<![CDATA[END_IF;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[Out_Alarm_Flow_Invalid := NOT Is_Flow_Valid;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="25">
<![CDATA[// 功能段 2: 总累计与分钟累计]]>
</Line>
<Line Number="26">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[IF In_Run AND Is_Flow_Valid THEN]]>
</Line>
<Line Number="29">
<![CDATA[    Out_Tot_Frac := Out_Tot_Frac + Flow_Increment;]]>
</Line>
<Line Number="30">
<![CDATA[    WHILE Out_Tot_Frac >= 1.0 DO]]>
</Line>
<Line Number="31">
<![CDATA[        Out_Tot_Int := Out_Tot_Int + 1;]]>
</Line>
<Line Number="32">
<![CDATA[        Out_Tot_Frac := Out_Tot_Frac - 1.0;]]>
</Line>
<Line Number="33">
<![CDATA[    END_WHILE;]]>
</Line>
<Line Number="34">
<![CDATA[    WHILE Out_Tot_Frac < 0.0 DO]]>
</Line>
<Line Number="35">
<![CDATA[        Out_Tot_Int := Out_Tot_Int - 1;]]>
</Line>
<Line Number="36">
<![CDATA[        Out_Tot_Frac := Out_Tot_Frac + 1.0;]]>
</Line>
<Line Number="37">
<![CDATA[    END_WHILE;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[    Temp_Min := Temp_Min + Flow_Increment;]]>
</Line>
<Line Number="40">
<![CDATA[END_IF;]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[Out_Tot := INT_TO_REAL(Out_Tot_Int) + Out_Tot_Frac;]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[TONR_01.PRE := In_Tot_Min * 60000;]]>
</Line>
<Line Number="34">
<![CDATA[TONR_01.Reset := TONR_01.DN;]]>
</Line>
<Line Number="35">
<![CDATA[TONR_01.TimerEnable := In_Run;]]>
</Line>
<Line Number="36">
<![CDATA[TONR(TONR_01);]]>
</Line>
<Line Number="37">
<![CDATA[]]>
</Line>
<Line Number="38">
<![CDATA[IF TONR_01.DN THEN]]>
</Line>
<Line Number="39">
<![CDATA[    Out_Tot_Min := Temp_Min;]]>
</Line>
<Line Number="40">
<![CDATA[    Temp_Min := 0;]]>
</Line>
<Line Number="41">
<![CDATA[END_IF;]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="44">
<![CDATA[// 功能段 3: 天累计]]>
</Line>
<Line Number="45">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[IF In_Run AND Is_Flow_Valid THEN]]>
</Line>
<Line Number="48">
<![CDATA[    Temp_Day := Temp_Day + Flow_Increment;]]>
</Line>
<Line Number="49">
<![CDATA[END_IF;]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[Out_Tot_D_RT := Temp_Day;]]>
</Line>
<Line Number="52">
<![CDATA[]]>
</Line>
<Line Number="53">
<![CDATA[IF (Hour = In_Day_Time_Hour) AND (Minute = In_Day_Time_Minute) AND (Second <= 1) THEN]]>
</Line>
<Line Number="54">
<![CDATA[    Out_Tot_D := Temp_Day;]]>
</Line>
<Line Number="55">
<![CDATA[    Out_Tot_D_RT := 0;]]>
</Line>
<Line Number="56">
<![CDATA[END_IF;]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[IF (Hour = In_Day_Time_Hour) AND (Minute = In_Day_Time_Minute) AND (Second >= 2) AND (Second <= 3) THEN]]>
</Line>
<Line Number="59">
<![CDATA[    Temp_Day := 0;]]>
</Line>
<Line Number="60">
<![CDATA[END_IF;]]>
</Line>
<Line Number="61">
<![CDATA[]]>
</Line>
<Line Number="62">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="63">
<![CDATA[// 功能段 4: 月累计]]>
</Line>
<Line Number="64">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="65">
<![CDATA[]]>
</Line>
<Line Number="66">
<![CDATA[Is_Leap_Year := (Year MOD 4 = 0) AND (Year MOD 100 <> 0) OR (Year MOD 400 = 0);]]>
</Line>
<Line Number="67">
<![CDATA[]]>
</Line>
<Line Number="68">
<![CDATA[CASE Month OF]]>
</Line>
<Line Number="69">
<![CDATA[    1, 3, 5, 7, 8, 10, 12: Days_In_Month := 31;]]>
</Line>
<Line Number="70">
<![CDATA[    4, 6, 9, 11: Days_In_Month := 30;]]>
</Line>
<Line Number="71">
<![CDATA[    2:]]>
</Line>
<Line Number="72">
<![CDATA[        IF Is_Leap_Year THEN]]>
</Line>
<Line Number="73">
<![CDATA[            Days_In_Month := 29;]]>
</Line>
<Line Number="74">
<![CDATA[        ELSE]]>
</Line>
<Line Number="75">
<![CDATA[            Days_In_Month := 28;]]>
</Line>
<Line Number="76">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="77">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="78">
<![CDATA[]]>
</Line>
<Line Number="79">
<![CDATA[IF (Day >= 1) AND (Day <= Days_In_Month) AND In_Run AND Is_Flow_Valid THEN]]>
</Line>
<Line Number="80">
<![CDATA[    Temp_Month := Temp_Month + Flow_Increment;]]>
</Line>
<Line Number="81">
<![CDATA[END_IF;]]>
</Line>
<Line Number="82">
<![CDATA[]]>
</Line>
<Line Number="83">
<![CDATA[IF (Day >= 1) AND (Day <= Days_In_Month) THEN]]>
</Line>
<Line Number="84">
<![CDATA[    Out_Tot_M_RT := Temp_Month;]]>
</Line>
<Line Number="85">
<![CDATA[END_IF;]]>
</Line>
<Line Number="86">
<![CDATA[]]>
</Line>
<Line Number="87">
<![CDATA[IF (Day = 1) AND (Hour = 0) AND (Minute = 0) AND (Second <= 1) THEN]]>
</Line>
<Line Number="88">
<![CDATA[    Out_Tot_M := Temp_Month;]]>
</Line>
<Line Number="89">
<![CDATA[    Out_Tot_M_RT := 0;]]>
</Line>
<Line Number="90">
<![CDATA[END_IF;]]>
</Line>
<Line Number="91">
<![CDATA[]]>
</Line>
<Line Number="92">
<![CDATA[IF (Day = 1) AND (Hour = 0) AND (Minute = 0) AND (Second >= 2) AND (Second <= 3) THEN]]>
</Line>
<Line Number="93">
<![CDATA[    Temp_Month := 0;]]>
</Line>
<Line Number="94">
<![CDATA[END_IF;]]>
</Line>
<Line Number="95">
<![CDATA[]]>
</Line>
<Line Number="96">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="97">
<![CDATA[// 功能段 5: HMI 命令处理]]>
</Line>
<Line Number="98">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="99">
<![CDATA[]]>
</Line>
<Line Number="100">
<![CDATA[IF HMI_CMD.Clear THEN]]>
</Line>
<Line Number="101">
<![CDATA[    Out_Tot := 0;]]>
</Line>
<Line Number="102">
<![CDATA[    Out_Tot_Int := 0;]]>
</Line>
<Line Number="103">
<![CDATA[    Out_Tot_Frac := 0.0;]]>
</Line>
<Line Number="104">
<![CDATA[    Out_Tot_Min := 0;]]>
</Line>
<Line Number="103">
<![CDATA[    Out_Tot_D_RT := 0;]]>
</Line>
<Line Number="104">
<![CDATA[    Out_Tot_M_RT := 0;]]>
</Line>
<Line Number="105">
<![CDATA[    Out_Tot_D := 0;]]>
</Line>
<Line Number="106">
<![CDATA[    Out_Tot_M := 0;]]>
</Line>
<Line Number="107">
<![CDATA[]]>
</Line>
<Line Number="108">
<![CDATA[    Temp_Min := 0;]]>
</Line>
<Line Number="109">
<![CDATA[    Temp_Day := 0;]]>
</Line>
<Line Number="110">
<![CDATA[    Temp_Month := 0;]]>
</Line>
<Line Number="111">
<![CDATA[]]>
</Line>
<Line Number="112">
<![CDATA[    HMI_CMD.Clear := 0;]]>
</Line>
<Line Number="113">
<![CDATA[END_IF;]]>
</Line>
<Line Number="114">
<![CDATA[]]>
</Line>
<Line Number="115">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="116">
<![CDATA[// 功能段 6: HMI 数据同步]]>
</Line>
<Line Number="117">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="118">
<![CDATA[]]>
</Line>
<Line Number="119">
<![CDATA[HMI_CMD.Out_Tot := Out_Tot;]]>
</Line>
<Line Number="120">
<![CDATA[HMI_CMD.Out_Tot_Int := Out_Tot_Int;]]>
</Line>
<Line Number="121">
<![CDATA[HMI_CMD.Out_Tot_Frac := Out_Tot_Frac;]]>
</Line>
<Line Number="122">
<![CDATA[HMI_CMD.Out_Tot_Min := Out_Tot_Min;]]>
</Line>
<Line Number="121">
<![CDATA[HMI_CMD.Out_Tot_D_RT := Out_Tot_D_RT;]]>
</Line>
<Line Number="122">
<![CDATA[HMI_CMD.Out_Tot_M_RT := Out_Tot_M_RT;]]>
</Line>
<Line Number="123">
<![CDATA[HMI_CMD.Out_Tot_D := Out_Tot_D;]]>
</Line>
<Line Number="124">
<![CDATA[HMI_CMD.Out_Tot_M := Out_Tot_M;]]>
</Line>
<Line Number="125">
<![CDATA[HMI_CMD.Alarm_Flow_Invalid := Out_Alarm_Flow_Invalid;]]>
</Line>
<Line Number="126">
<![CDATA[]]>
</Line>
<Line Number="127">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="128">
<![CDATA[// 功能段 7: 启用状态输出]]>
</Line>
<Line Number="129">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="130">
<![CDATA[]]>
</Line>
<Line Number="131">
<![CDATA[EnableOut := EnableIn;]]>
</Line>
<Line Number="132">
<![CDATA[]]>
</Line>
<Line Number="133">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="134">
<![CDATA[// 程序结束]]>
</Line>
<Line Number="135">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="136">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="FlowRateTot_Type"/>
</Dependencies>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
