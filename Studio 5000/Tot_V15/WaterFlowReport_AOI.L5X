</DefaultData>
</LocalTag>
<LocalTag Name="Last_Tot_M" DataType="REAL" Radix="Float" ExternalAccess="None">
<Description>
<![CDATA[上次月切换时刻的总累计基准值]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
