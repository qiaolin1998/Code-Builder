<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="1">
<![CDATA[// AOI 名称: FlowRateTot_3Shift (三班制流量累计系统)]]>
</Line>
<Line Number="2">
<![CDATA[// 版本: 1.0]]>
</Line>
<Line Number="3">
<![CDATA[// 编程语言: Structured Text (ST)]]>
</Line>
<Line Number="4">
<![CDATA[// 适用平台: Studio 5000 (ControlLogix/CompactLogix)]]>
</Line>
<Line Number="5">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="6">
<![CDATA[// 功能概述:]]>
</Line>
<Line Number="7">
<![CDATA[// 1. 根据流量计瞬时流量计算累计量,核心公式: 累计量 = 瞬时流量 × 时间间隔]]>
</Line>
<Line Number="8">
<![CDATA[// 2. 保留 OreProdStats_3Shift 的三班制产量统计框架;]]>
</Line>
<Line Number="9">
<![CDATA[// 3. 三个班次的时间范围固定如下:]]>
</Line>
<Line Number="10">
<![CDATA[//    - 早班: 09:00 – 17:00]]>
</Line>
<Line Number="11">
<![CDATA[//    - 中班: 17:00 – 次日 01:00 (跨越午夜)]]>
</Line>
<Line Number="12">
<![CDATA[//    - 晚班: 01:00 – 09:00]]>
</Line>
<Line Number="13">
<![CDATA[// 4. 在每个班内部,再划分为连续的 4 个 2 小时段,对每段单独累计产量:]]>
</Line>
<Line Number="14">
<![CDATA[//    - 早班:  9–11, 11–13, 13–15, 15–17]]>
</Line>
<Line Number="15">
<![CDATA[//    - 中班: 17–19, 19–21, 21–23, 23–1]]>
</Line>
<Line Number="16">
<![CDATA[//    - 晚班:  1–3,  3–5,  5–7,  7–9]]>
</Line>
<Line Number="17">
<![CDATA[// 5. 增加流量有效性判断: 流量超出上下限范围时停止累计并输出报警]]>
</Line>
<Line Number="18">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="19">
<![CDATA[// 设计说明:]]>
</Line>
<Line Number="20">
<![CDATA[// 1. 积分方式:]]>
</Line>
<Line Number="21">
<![CDATA[//    - 每次扫描周期执行积分: Flow_Increment = In_Flow_Rate × (In_Scan_Time / 3600000.0)]]>
</Line>
<Line Number="22">
<![CDATA[//    - In_Scan_Time 单位为毫秒,除以 3600000 转换为小时]]>
</Line>
<Line Number="23">
<![CDATA[//    - 若流量单位为 m³/h,则累计量单位为 m³]]>
</Line>
<Line Number="24">
<![CDATA[// 2. 流量有效性判断:]]>
</Line>
<Line Number="25">
<![CDATA[//    - In_Flow_Rate >= In_Flow_Min 且 In_Flow_Rate <= In_Flow_Max 时视为有效]]>
</Line>
<Line Number="26">
<![CDATA[//    - 无效流量不参与累计,并置位 Out_Alarm_Flow_Invalid]]>
</Line>
<Line Number="27">
<![CDATA[// 3. 时间基准与班次判定与原 OreProdStats_3Shift 相同]]>
</Line>
<Line Number="28">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="29">
<![CDATA[// 变量约定:]]>
</Line>
<Line Number="30">
<![CDATA[// 1. 输入:]]>
</Line>
<Line Number="31">
<![CDATA[//    - In_Flow_Rate: REAL;    // 瞬时流量(如 m³/h 或 t/h)]]>
</Line>
<Line Number="32">
<![CDATA[//    - In_Scan_Time: DINT;    // 扫描周期(毫秒),默认 100ms]]>
</Line>
<Line Number="33">
<![CDATA[//    - In_Flow_Max: REAL;     // 流量上限]]>
</Line>
<Line Number="34">
<![CDATA[//    - In_Flow_Min: REAL;     // 流量下限(通常为负,表示反向流)]]>
</Line>
<Line Number="35">
<![CDATA[// 2. 输出:]]>
</Line>
<Line Number="36">
<![CDATA[//    - Out_Alarm_Flow_Invalid: BOOL;  // 流量无效报警]]>
</Line>
<Line Number="37">
<![CDATA[// 3. 本地变量:]]>
</Line>
<Line Number="38">
<![CDATA[//    - Flow_Increment: REAL;  // 本次扫描的流量增量]]>
</Line>
<Line Number="39">
<![CDATA[//    - Is_Flow_Valid: BOOL;   // 流量有效性标志]]>
</Line>
<Line Number="40">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="43">
<![CDATA[// 功能段 1: 流量有效性判断与积分增量计算]]>
</Line>
<Line Number="44">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[Is_Flow_Valid := (In_Flow_Rate >= In_Flow_Min) AND (In_Flow_Rate <= In_Flow_Max);]]>
</Line>
<Line Number="47">
<![CDATA[]]>
</Line>
<Line Number="48">
<![CDATA[IF Is_Flow_Valid THEN]]>
</Line>
<Line Number="49">
<![CDATA[    Flow_Increment := In_Flow_Rate * REAL(In_Scan_Time) / 3600000.0;]]>
</Line>
<Line Number="50">
<![CDATA[ELSE]]>
</Line>
<Line Number="51">
<![CDATA[    Flow_Increment := 0.0;]]>
</Line>
<Line Number="52">
<![CDATA[END_IF;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[Out_Alarm_Flow_Invalid := NOT Is_Flow_Valid;]]>
</Line>
<Line Number="55">
<![CDATA[]]>
</Line>
<Line Number="56">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="57">
<![CDATA[// 功能段 2: 总累计与分钟累计]]>
</Line>
<Line Number="58">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[IF In_Run AND Is_Flow_Valid THEN]]>
</Line>
<Line Number="61">
<![CDATA[    Out_Tot := Out_Tot + Flow_Increment;]]>
</Line>
<Line Number="62">
<![CDATA[    Temp[0] := Temp[0] + Flow_Increment;]]>
</Line>
<Line Number="63">
<![CDATA[END_IF;]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
<Line Number="65">
<![CDATA[// 分钟累计定时器]]>
</Line>
<Line Number="66">
<![CDATA[TONR_01.PRE := In_Tot_Min * 60000;]]>
</Line>
<Line Number="67">
<![CDATA[TONR_01.Reset := TONR_01.DN;]]>
</Line>
<Line Number="68">
<![CDATA[TONR_01.TimerEnable := In_Run;]]>
</Line>
<Line Number="69">
<![CDATA[TONR(TONR_01);]]>
</Line>
<Line Number="70">
<![CDATA[]]>
</Line>
<Line Number="71">
<![CDATA[IF TONR_01.DN THEN]]>
</Line>
<Line Number="72">
<![CDATA[    Out_Tot_Min := Temp[0];]]>
</Line>
<Line Number="73">
<![CDATA[    Temp[0] := 0;]]>
</Line>
<Line Number="74">
<![CDATA[END_IF;]]>
</Line>
<Line Number="75">
<![CDATA[]]>
</Line>
<Line Number="76">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="77">
<![CDATA[// 功能段 3: 时间数据准备]]>
</Line>
<Line Number="78">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="79">
<![CDATA[]]>
</Line>
<Line Number="80">
<![CDATA[Time[0] := Year;]]>
</Line>
<Line Number="81">
<![CDATA[Time[1] := Month;]]>
</Line>
<Line Number="82">
<![CDATA[Time[2] := Day;]]>
</Line>
<Line Number="83">
<![CDATA[Time[3] := Hour;]]>
</Line>
<Line Number="84">
<![CDATA[Time[4] := Minute;]]>
</Line>
<Line Number="85">
<![CDATA[Time[5] := Second;]]>
</Line>
<Line Number="86">
<![CDATA[]]>
</Line>
<Line Number="87">
<![CDATA[Time_Real := Hour * 60 + Minute;]]>
</Line>
<Line Number="88">
<![CDATA[]]>
</Line>
<Line Number="89">
<![CDATA[Time_Set1 := In_Class1_Time_Hour * 60 + In_Class1_Time_Minute;]]>
</Line>
<Line Number="90">
<![CDATA[Time_Set2 := In_Class2_Time_Hour * 60 + In_Class2_Time_Minute;]]>
</Line>
<Line Number="91">
<![CDATA[Time_Set3_Day := In_Day_Time_Hour * 60 + In_Day_Time_Minute;]]>
</Line>
<Line Number="92">
<![CDATA[]]>
</Line>
<Line Number="93">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="94">
<![CDATA[// 功能段 4: 三班制班次判定与 2 小时段计算]]>
</Line>
<Line Number="95">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="96">
<![CDATA[]]>
</Line>
<Line Number="97">
<![CDATA[IF (Time_Real >= 9 * 60) AND (Time_Real < 17 * 60) THEN]]>
</Line>
<Line Number="98">
<![CDATA[    Shift_ID := 1;]]>
</Line>
<Line Number="99">
<![CDATA[ELSIF (Time_Real >= 17 * 60) OR (Time_Real < 1 * 60) THEN]]>
</Line>
<Line Number="100">
<![CDATA[    Shift_ID := 2;]]>
</Line>
<Line Number="101">
<![CDATA[ELSE]]>
</Line>
<Line Number="102">
<![CDATA[    Shift_ID := 3;]]>
</Line>
<Line Number="103">
<![CDATA[END_IF;]]>
</Line>
<Line Number="104">
<![CDATA[]]>
</Line>
<Line Number="105">
<![CDATA[CASE Shift_ID OF]]>
</Line>
<Line Number="106">
<![CDATA[    1:]]>
</Line>
<Line Number="107">
<![CDATA[        Minutes_From_Shift_Start := Time_Real - 9 * 60;]]>
</Line>
<Line Number="108">
<![CDATA[    2:]]>
</Line>
<Line Number="109">
<![CDATA[        IF Time_Real >= 17 * 60 THEN]]>
</Line>
<Line Number="110">
<![CDATA[            Minutes_From_Shift_Start := Time_Real - 17 * 60;]]>
</Line>
<Line Number="111">
<![CDATA[        ELSE]]>
</Line>
<Line Number="112">
<![CDATA[            Minutes_From_Shift_Start := Time_Real + 1440 - 17 * 60;]]>
</Line>
<Line Number="113">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="114">
<![CDATA[    3:]]>
</Line>
<Line Number="115">
<![CDATA[        IF Time_Real >= 1 * 60 THEN]]>
</Line>
<Line Number="116">
<![CDATA[            Minutes_From_Shift_Start := Time_Real - 1 * 60;]]>
</Line>
<Line Number="117">
<![CDATA[        ELSE]]>
</Line>
<Line Number="118">
<![CDATA[            Minutes_From_Shift_Start := Time_Real + 1440 - 1 * 60;]]>
</Line>
<Line Number="119">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="120">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="121">
<![CDATA[]]>
</Line>
<Line Number="122">
<![CDATA[Shift_Section_ID := Minutes_From_Shift_Start / 120;]]>
</Line>
<Line Number="123">
<![CDATA[]]>
</Line>
<Line Number="124">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="125">
<![CDATA[// 功能段 5: 三班制班累计与 2 小时段累计]]>
</Line>
<Line Number="126">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="127">
<![CDATA[]]>
</Line>
<Line Number="128">
<![CDATA[IF In_Run AND Is_Flow_Valid THEN]]>
</Line>
<Line Number="129">
<![CDATA[    CASE Shift_ID OF]]>
</Line>
<Line Number="130">
<![CDATA[        1:  TempShift1 := TempShift1 + Flow_Increment;]]>
</Line>
<Line Number="131">
<![CDATA[        2:  TempShift2 := TempShift2 + Flow_Increment;]]>
</Line>
<Line Number="132">
<![CDATA[        3:  TempShift3 := TempShift3 + Flow_Increment;]]>
</Line>
<Line Number="133">
<![CDATA[    END_CASE;]]>
</Line>
<Line Number="134">
<![CDATA[]]>
</Line>
<Line Number="135">
<![CDATA[    CASE Shift_ID OF]]>
</Line>
<Line Number="136">
<![CDATA[        1:]]>
</Line>
<Line Number="137">
<![CDATA[            CASE Shift_Section_ID OF]]>
</Line>
<Line Number="138">
<![CDATA[                0: TempShift1_2H_1 := TempShift1_2H_1 + Flow_Increment;]]>
</Line>
<Line Number="139">
<![CDATA[                1: TempShift1_2H_2 := TempShift1_2H_2 + Flow_Increment;]]>
</Line>
<Line Number="140">
<![CDATA[                2: TempShift1_2H_3 := TempShift1_2H_3 + Flow_Increment;]]>
</Line>
<Line Number="141">
<![CDATA[                3: TempShift1_2H_4 := TempShift1_2H_4 + Flow_Increment;]]>
</Line>
<Line Number="142">
<![CDATA[            END_CASE;]]>
</Line>
<Line Number="143">
<![CDATA[        2:]]>
</Line>
<Line Number="144">
<![CDATA[            CASE Shift_Section_ID OF]]>
</Line>
<Line Number="145">
<![CDATA[                0: TempShift2_2H_1 := TempShift2_2H_1 + Flow_Increment;]]>
</Line>
<Line Number="146">
<![CDATA[                1: TempShift2_2H_2 := TempShift2_2H_2 + Flow_Increment;]]>
</Line>
<Line Number="147">
<![CDATA[                2: TempShift2_2H_3 := TempShift2_2H_3 + Flow_Increment;]]>
</Line>
<Line Number="148">
<![CDATA[                3: TempShift2_2H_4 := TempShift2_2H_4 + Flow_Increment;]]>
</Line>
<Line Number="149">
<![CDATA[            END_CASE;]]>
</Line>
<Line Number="150">
<![CDATA[        3:]]>
</Line>
<Line Number="151">
<![CDATA[            CASE Shift_Section_ID OF]]>
</Line>
<Line Number="152">
<![CDATA[                0: TempShift3_2H_1 := TempShift3_2H_1 + Flow_Increment;]]>
</Line>
<Line Number="153">
<![CDATA[                1: TempShift3_2H_2 := TempShift3_2H_2 + Flow_Increment;]]>
</Line>
<Line Number="154">
<![CDATA[                2: TempShift3_2H_3 := TempShift3_2H_3 + Flow_Increment;]]>
</Line>
<Line Number="155">
<![CDATA[                3: TempShift3_2H_4 := TempShift3_2H_4 + Flow_Increment;]]>
</Line>
<Line Number="156">
<![CDATA[            END_CASE;]]>
</Line>
<Line Number="157">
<![CDATA[    END_CASE;]]>
</Line>
<Line Number="158">
<![CDATA[END_IF;]]>
</Line>
<Line Number="159">
<![CDATA[]]>
</Line>
<Line Number="160">
<![CDATA[Out_Tot_Shift1_RT := TempShift1;]]>
</Line>
<Line Number="161">
<![CDATA[Out_Tot_Shift2_RT := TempShift2;]]>
</Line>
<Line Number="162">
<![CDATA[Out_Tot_Shift3_RT := TempShift3;]]>
</Line>
<Line Number="163">
<![CDATA[]]>
</Line>
<Line Number="164">
<![CDATA[CASE Shift_ID OF]]>
</Line>
<Line Number="165">
<![CDATA[    1: Out_Tot_Shift_RT := Out_Tot_Shift1_RT;]]>
</Line>
<Line Number="166">
<![CDATA[    2: Out_Tot_Shift_RT := Out_Tot_Shift2_RT;]]>
</Line>
<Line Number="167">
<![CDATA[    3: Out_Tot_Shift_RT := Out_Tot_Shift3_RT;]]>
</Line>
<Line Number="168">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="169">
<![CDATA[]]>
</Line>
<Line Number="170">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="171">
<![CDATA[// 功能段 6: 班结束时保存班累计并清零]]>
</Line>
<Line Number="172">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="173">
<![CDATA[]]>
</Line>
<Line Number="174">
<![CDATA[IF (Hour = 17) AND (Minute = 0) AND (Second <= 1) THEN]]>
</Line>
<Line Number="175">
<![CDATA[    Out_Tot_Shift1 := TempShift1;]]>
</Line>
<Line Number="176">
<![CDATA[    Out_Tot_Shift1_RT := 0;]]>
</Line>
<Line Number="177">
<![CDATA[END_IF;]]>
</Line>
<Line Number="178">
<![CDATA[]]>
</Line>
<Line Number="179">
<![CDATA[IF (Hour = 17) AND (Minute = 0) AND (Second >= 2) AND (Second <= 3) THEN]]>
</Line>
<Line Number="180">
<![CDATA[    TempShift1 := 0;]]>
</Line>
<Line Number="181">
<![CDATA[END_IF;]]>
</Line>
<Line Number="182">
<![CDATA[]]>
</Line>
<Line Number="183">
<![CDATA[IF (Hour = 1) AND (Minute = 0) AND (Second <= 1) THEN]]>
</Line>
<Line Number="184">
<![CDATA[    Out_Tot_Shift2 := TempShift2;]]>
</Line>
<Line Number="185">
<![CDATA[    Out_Tot_Shift2_RT := 0;]]>
</Line>
<Line Number="186">
<![CDATA[END_IF;]]>
</Line>
<Line Number="187">
<![CDATA[]]>
</Line>
<Line Number="188">
<![CDATA[IF (Hour = 1) AND (Minute = 0) AND (Second >= 2) AND (Second <= 3) THEN]]>
</Line>
<Line Number="189">
<![CDATA[    TempShift2 := 0;]]>
</Line>
<Line Number="190">
<![CDATA[END_IF;]]>
</Line>
<Line Number="191">
<![CDATA[]]>
</Line>
<Line Number="192">
<![CDATA[IF (Hour = 9) AND (Minute = 0) AND (Second <= 1) THEN]]>
</Line>
<Line Number="193">
<![CDATA[    Out_Tot_Shift3 := TempShift3;]]>
</Line>
<Line Number="194">
<![CDATA[    Out_Tot_Shift3_RT := 0;]]>
</Line>
<Line Number="195">
<![CDATA[END_IF;]]>
</Line>
<Line Number="196">
<![CDATA[]]>
</Line>
<Line Number="197">
<![CDATA[IF (Hour = 9) AND (Minute = 0) AND (Second >= 2) AND (Second <= 3) THEN]]>
</Line>
<Line Number="198">
<![CDATA[    TempShift3 := 0;]]>
</Line>
<Line Number="199">
<![CDATA[END_IF;]]>
</Line>
<Line Number="200">
<![CDATA[]]>
</Line>
<Line Number="201">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="202">
<![CDATA[// 功能段 7: 每 2 小时段结束时保存该段产量]]>
</Line>
<Line Number="203">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="204">
<![CDATA[]]>
</Line>
<Line Number="205">
<![CDATA[IF (Minutes_From_Shift_Start MOD 120 = 0) AND (Second <= 1) THEN]]>
</Line>
<Line Number="206">
<![CDATA[    Prev_Section_ID := (Shift_Section_ID + 3) MOD 4;]]>
</Line>
<Line Number="207">
<![CDATA[]]>
</Line>
<Line Number="208">
<![CDATA[    CASE Shift_ID OF]]>
</Line>
<Line Number="209">
<![CDATA[        1:]]>
</Line>
<Line Number="210">
<![CDATA[            CASE Prev_Section_ID OF]]>
</Line>
<Line Number="211">
<![CDATA[                0: Out_Tot_Shift1_2H_1 := TempShift1_2H_1; TempShift1_2H_1 := 0;]]>
</Line>
<Line Number="212">
<![CDATA[                1: Out_Tot_Shift1_2H_2 := TempShift1_2H_2; TempShift1_2H_2 := 0;]]>
</Line>
<Line Number="213">
<![CDATA[                2: Out_Tot_Shift1_2H_3 := TempShift1_2H_3; TempShift1_2H_3 := 0;]]>
</Line>
<Line Number="214">
<![CDATA[                3: Out_Tot_Shift1_2H_4 := TempShift1_2H_4; TempShift1_2H_4 := 0;]]>
</Line>
<Line Number="215">
<![CDATA[            END_CASE;]]>
</Line>
<Line Number="216">
<![CDATA[        2:]]>
</Line>
<Line Number="217">
<![CDATA[            CASE Prev_Section_ID OF]]>
</Line>
<Line Number="218">
<![CDATA[                0: Out_Tot_Shift2_2H_1 := TempShift2_2H_1; TempShift2_2H_1 := 0;]]>
</Line>
<Line Number="219">
<![CDATA[                1: Out_Tot_Shift2_2H_2 := TempShift2_2H_2; TempShift2_2H_2 := 0;]]>
</Line>
<Line Number="220">
<![CDATA[                2: Out_Tot_Shift2_2H_3 := TempShift2_2H_3; TempShift2_2H_3 := 0;]]>
</Line>
<Line Number="221">
<![CDATA[                3: Out_Tot_Shift2_2H_4 := TempShift2_2H_4; TempShift2_2H_4 := 0;]]>
</Line>
<Line Number="222">
<![CDATA[            END_CASE;]]>
</Line>
<Line Number="223">
<![CDATA[        3:]]>
</Line>
<Line Number="224">
<![CDATA[            CASE Prev_Section_ID OF]]>
</Line>
<Line Number="225">
<![CDATA[                0: Out_Tot_Shift3_2H_1 := TempShift3_2H_1; TempShift3_2H_1 := 0;]]>
</Line>
<Line Number="226">
<![CDATA[                1: Out_Tot_Shift3_2H_2 := TempShift3_2H_2; TempShift3_2H_2 := 0;]]>
</Line>
<Line Number="227">
<![CDATA[                2: Out_Tot_Shift3_2H_3 := TempShift3_2H_3; TempShift3_2H_3 := 0;]]>
</Line>
<Line Number="228">
<![CDATA[                3: Out_Tot_Shift3_2H_4 := TempShift3_2H_4; TempShift3_2H_4 := 0;]]>
</Line>
<Line Number="229">
<![CDATA[            END_CASE;]]>
</Line>
<Line Number="230">
<![CDATA[    END_CASE;]]>
</Line>
<Line Number="231">
<![CDATA[END_IF;]]>
</Line>
<Line Number="232">
<![CDATA[]]>
</Line>
<Line Number="233">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="234">
<![CDATA[// 功能段 8: 天累计逻辑]]>
</Line>
<Line Number="235">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="236">
<![CDATA[]]>
</Line>
<Line Number="237">
<![CDATA[IF In_Run AND Is_Flow_Valid THEN]]>
</Line>
<Line Number="238">
<![CDATA[    Temp[8] := Temp[8] + Flow_Increment;]]>
</Line>
<Line Number="239">
<![CDATA[END_IF;]]>
</Line>
<Line Number="240">
<![CDATA[]]>
</Line>
<Line Number="241">
<![CDATA[Out_Tot_D_RT := Temp[8];]]>
</Line>
<Line Number="242">
<![CDATA[]]>
</Line>
<Line Number="243">
<![CDATA[IF (Hour = In_Day_Time_Hour) AND (Minute = In_Day_Time_Minute) AND (Second <= 1) THEN]]>
</Line>
<Line Number="244">
<![CDATA[    Out_Tot_D := Temp[8];]]>
</Line>
<Line Number="245">
<![CDATA[    Out_Tot_D_RT := 0;]]>
</Line>
<Line Number="246">
<![CDATA[END_IF;]]>
</Line>
<Line Number="247">
<![CDATA[]]>
</Line>
<Line Number="248">
<![CDATA[IF (Hour = In_Day_Time_Hour) AND (Minute = In_Day_Time_Minute) AND (Second >= 2) AND (Second <= 3) THEN]]>
</Line>
<Line Number="249">
<![CDATA[    Temp[8] := 0;]]>
</Line>
<Line Number="250">
<![CDATA[END_IF;]]>
</Line>
<Line Number="251">
<![CDATA[]]>
</Line>
<Line Number="252">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="253">
<![CDATA[// 功能段 9: 月累计逻辑]]>
</Line>
<Line Number="254">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="255">
<![CDATA[]]>
</Line>
<Line Number="256">
<![CDATA[Is_Leap_Year := (Year MOD 4 = 0) AND (Year MOD 100 <> 0) OR (Year MOD 400 = 0);]]>
</Line>
<Line Number="257">
<![CDATA[]]>
</Line>
<Line Number="258">
<![CDATA[CASE Month OF]]>
</Line>
<Line Number="259">
<![CDATA[    1, 3, 5, 7, 8, 10, 12: Days_In_Month := 31;]]>
</Line>
<Line Number="260">
<![CDATA[    4, 6, 9, 11: Days_In_Month := 30;]]>
</Line>
<Line Number="261">
<![CDATA[    2:]]>
</Line>
<Line Number="262">
<![CDATA[        IF Is_Leap_Year THEN]]>
</Line>
<Line Number="263">
<![CDATA[            Days_In_Month := 29;]]>
</Line>
<Line Number="264">
<![CDATA[        ELSE]]>
</Line>
<Line Number="265">
<![CDATA[            Days_In_Month := 28;]]>
</Line>
<Line Number="266">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="267">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="268">
<![CDATA[]]>
</Line>
<Line Number="269">
<![CDATA[IF (Day >= 1) AND (Day <= Days_In_Month) AND In_Run AND Is_Flow_Valid THEN]]>
</Line>
<Line Number="270">
<![CDATA[    Temp[4] := Temp[4] + Flow_Increment;]]>
</Line>
<Line Number="271">
<![CDATA[END_IF;]]>
</Line>
<Line Number="272">
<![CDATA[]]>
</Line>
<Line Number="273">
<![CDATA[IF (Day >= 1) AND (Day <= Days_In_Month) THEN]]>
</Line>
<Line Number="274">
<![CDATA[    Out_Tot_M_RT := Temp[4];]]>
</Line>
<Line Number="275">
<![CDATA[END_IF;]]>
</Line>
<Line Number="276">
<![CDATA[]]>
</Line>
<Line Number="277">
<![CDATA[IF (Day = 1) AND (Hour = 0) AND (Minute = 0) AND (Second <= 1) THEN]]>
</Line>
<Line Number="278">
<![CDATA[    Out_Tot_M := Temp[4];]]>
</Line>
<Line Number="279">
<![CDATA[    Out_Tot_M_RT := 0;]]>
</Line>
<Line Number="280">
<![CDATA[END_IF;]]>
</Line>
<Line Number="281">
<![CDATA[]]>
</Line>
<Line Number="282">
<![CDATA[IF (Day = 1) AND (Hour = 0) AND (Minute = 0) AND (Second >= 2) AND (Second <= 3) THEN]]>
</Line>
<Line Number="283">
<![CDATA[    Temp[4] := 0;]]>
</Line>
<Line Number="284">
<![CDATA[END_IF;]]>
</Line>
<Line Number="285">
<![CDATA[]]>
</Line>
<Line Number="286">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="287">
<![CDATA[// 功能段 10: HMI 命令处理]]>
</Line>
<Line Number="288">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="289">
<![CDATA[]]>
</Line>
<Line Number="290">
<![CDATA[IF HMI_CMD.Clear THEN]]>
</Line>
<Line Number="291">
<![CDATA[    Out_Tot := 0;]]>
</Line>
<Line Number="292">
<![CDATA[    Out_Tot_Min := 0;]]>
</Line>
<Line Number="293">
<![CDATA[    Out_Tot_D_RT := 0;]]>
</Line>
<Line Number="294">
<![CDATA[    Out_Tot_M_RT := 0;]]>
</Line>
<Line Number="295">
<![CDATA[    Out_Tot_D := 0;]]>
</Line>
<Line Number="296">
<![CDATA[    Out_Tot_M := 0;]]>
</Line>
<Line Number="297">
<![CDATA[]]>
</Line>
<Line Number="298">
<![CDATA[    Out_Tot_Shift1 := 0;]]>
</Line>
<Line Number="299">
<![CDATA[    Out_Tot_Shift2 := 0;]]>
</Line>
<Line Number="300">
<![CDATA[    Out_Tot_Shift3 := 0;]]>
</Line>
<Line Number="301">
<![CDATA[]]>
</Line>
<Line Number="302">
<![CDATA[    Out_Tot_Shift1_RT := 0;]]>
</Line>
<Line Number="303">
<![CDATA[    Out_Tot_Shift2_RT := 0;]]>
</Line>
<Line Number="304">
<![CDATA[    Out_Tot_Shift3_RT := 0;]]>
</Line>
<Line Number="305">
<![CDATA[    Out_Tot_Shift_RT := 0;]]>
</Line>
<Line Number="306">
<![CDATA[]]>
</Line>
<Line Number="307">
<![CDATA[    Out_Tot_Shift1_2H_1 := 0; Out_Tot_Shift1_2H_2 := 0;]]>
</Line>
<Line Number="308">
<![CDATA[    Out_Tot_Shift1_2H_3 := 0; Out_Tot_Shift1_2H_4 := 0;]]>
</Line>
<Line Number="309">
<![CDATA[]]>
</Line>
<Line Number="310">
<![CDATA[    Out_Tot_Shift2_2H_1 := 0; Out_Tot_Shift2_2H_2 := 0;]]>
</Line>
<Line Number="311">
<![CDATA[    Out_Tot_Shift2_2H_3 := 0; Out_Tot_Shift2_2H_4 := 0;]]>
</Line>
<Line Number="312">
<![CDATA[]]>
</Line>
<Line Number="313">
<![CDATA[    Out_Tot_Shift3_2H_1 := 0; Out_Tot_Shift3_2H_2 := 0;]]>
</Line>
<Line Number="314">
<![CDATA[    Out_Tot_Shift3_2H_3 := 0; Out_Tot_Shift3_2H_4 := 0;]]>
</Line>
<Line Number="315">
<![CDATA[]]>
</Line>
<Line Number="316">
<![CDATA[    Temp[0] := 0;]]>
</Line>
<Line Number="317">
<![CDATA[    Temp[4] := 0;]]>
</Line>
<Line Number="318">
<![CDATA[    Temp[8] := 0;]]>
</Line>
<Line Number="319">
<![CDATA[]]>
</Line>
<Line Number="320">
<![CDATA[    TempShift1 := 0; TempShift2 := 0; TempShift3 := 0;]]>
</Line>
<Line Number="321">
<![CDATA[]]>
</Line>
<Line Number="322">
<![CDATA[    TempShift1_2H_1 := 0; TempShift1_2H_2 := 0;]]>
</Line>
<Line Number="323">
<![CDATA[    TempShift1_2H_3 := 0; TempShift1_2H_4 := 0;]]>
</Line>
<Line Number="324">
<![CDATA[]]>
</Line>
<Line Number="325">
<![CDATA[    TempShift2_2H_1 := 0; TempShift2_2H_2 := 0;]]>
</Line>
<Line Number="326">
<![CDATA[    TempShift2_2H_3 := 0; TempShift2_2H_4 := 0;]]>
</Line>
<Line Number="327">
<![CDATA[]]>
</Line>
<Line Number="328">
<![CDATA[    TempShift3_2H_1 := 0; TempShift3_2H_2 := 0;]]>
</Line>
<Line Number="329">
<![CDATA[    TempShift3_2H_3 := 0; TempShift3_2H_4 := 0;]]>
</Line>
<Line Number="330">
<![CDATA[]]>
</Line>
<Line Number="331">
<![CDATA[    HMI_CMD.Clear := 0;]]>
</Line>
<Line Number="332">
<![CDATA[END_IF;]]>
</Line>
<Line Number="333">
<![CDATA[]]>
</Line>
<Line Number="334">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="335">
<![CDATA[// 功能段 11: HMI 数据同步]]>
</Line>
<Line Number="336">
<![CDATA[// ===============================================================]]>
</Line>
<Line Number="337">
<![CDATA[]]>
</Line>
<Line Number="338">
<![CDATA[HMI_CMD.Out_Tot := Out_Tot;]]>
</Line>
<Line Number="339">
<![CDATA[HMI_CMD.Out_Tot_Min := Out_Tot_Min;]]>
</Line>
<Line Number="340">
<![CDATA[HMI_CMD.Out_Tot_D_RT := Out_Tot_D_RT;]]>
</Line>
<Line Number="341">
<![CDATA[HMI_CMD.Out_Tot_M_RT := Out_Tot_M_RT;]]>
</Line>
<Line Number="342">
<![CDATA[HMI_CMD.Out_Tot_D := Out_Tot_D;]]>
</Line>
<Line Number="343">
<![CDATA[HMI_CMD.Out_Tot_M := Out_Tot_M;]]>
</Line>
<Line Number="344">
<![CDATA[]]>
</Line>
<Line Number="345">
<![CDATA[HMI_CMD.Out_Tot_Shift1 := Out_Tot_Shift1;]]>
